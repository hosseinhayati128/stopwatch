<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#032437" />
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#032437" />
    <SolidColorBrush x:Key="MenuForegroundBrush" Color="#FFF0D3" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#EFDCB5" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#E8D0A3" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#DFC28D" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#DAB77A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#9E7844" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#B59054" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#052536" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#64513A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#B77D2F" />
    <SolidColorBrush x:Key="TimerTextBrush" Color="#B77D2F" />
    <SolidColorBrush x:Key="PrimaryActionBrush" Color="#CD392C" />
    <SolidColorBrush x:Key="OnActionTextBrush" Color="#FFF5DD" />
    <SolidColorBrush x:Key="DangerActionBrush" Color="#852B22" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#A42B25" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#15865B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#A56D27" />
    <SolidColorBrush x:Key="MutedStatusBrush" Color="#92734F" />
    <SolidColorBrush x:Key="RecBrush" Color="#9C2C23" />
    <SolidColorBrush x:Key="ThemeShadowBrush" Color="Transparent" />
    <SolidColorBrush x:Key="OverlayChromeBrush" Color="#F00F2733" />
    <SolidColorBrush x:Key="OverlayChromeBorderBrush" Color="#8BB7C6" />
    <SolidColorBrush x:Key="OverlayHoverBrush" Color="#2FFFFFFF" />
    <SolidColorBrush x:Key="OverlayPressedBrush" Color="#4AFFFFFF" />
    <SolidColorBrush x:Key="OverlayActionForegroundBrush" Color="#EFDCB5" />
    <SolidColorBrush x:Key="NeutralButtonHoverBackgroundBrush" Color="#E8D0A3" />
    <SolidColorBrush x:Key="NeutralButtonHoverBorderBrush" Color="#9E7844" />
    <SolidColorBrush x:Key="NeutralButtonHoverForegroundBrush" Color="#052536" />
    <SolidColorBrush x:Key="NeutralButtonPressedBackgroundBrush" Color="#E8D0A3" />
    <SolidColorBrush x:Key="NeutralButtonPressedBorderBrush" Color="#9E7844" />
    <SolidColorBrush x:Key="NeutralButtonPressedForegroundBrush" Color="#052536" />
    <x:Double x:Key="NeutralButtonHoverOpacity">0.88</x:Double>
    <x:Double x:Key="NeutralButtonPressedOpacity">0.72</x:Double>
    <SolidColorBrush x:Key="ApplicationHeaderBrush" Color="#032437" />
    <SolidColorBrush x:Key="NavigationRailBrush" Color="#EFDCB5" />
    <SolidColorBrush x:Key="SelectedNavigationBrush" Color="#DAB77A" />
    <SolidColorBrush x:Key="TableHeaderBrush" Color="#E8D0A3" />
    <SolidColorBrush x:Key="ChartSeries1Brush" Color="#B77D2F" />
    <SolidColorBrush x:Key="ChartSeries2Brush" Color="#15865B" />
    <SolidColorBrush x:Key="ChartSeries3Brush" Color="#A56D27" />
    <SolidColorBrush x:Key="ChartSeries4Brush" Color="#A42B25" />
    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#EFDCB5" />
    <SolidColorBrush x:Key="OverlayInnerRuleBrush" Color="#8BB7C6" />
    <SolidColorBrush x:Key="OverlayToolbarSurfaceBrush" Color="#0F2733" />
    <SolidColorBrush x:Key="OrnamentStrokeBrush" Color="Transparent" />
    <SolidColorBrush x:Key="OrnamentAccentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ActiveItemBorderBrush" Color="#B77D2F" />
    <SolidColorBrush x:Key="SubtleDividerBrush" Color="#B59054" />
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#B77D2F" />
    <FontFamily x:Key="AppFontFamily">avares://StopwatchOverlay.Desktop/Assets/Fonts/Acanthus/#Inter</FontFamily>
    <FontFamily x:Key="DisplayHeadingFontFamily">avares://StopwatchOverlay.Desktop/Assets/Fonts/Acanthus/#Cormorant Garamond</FontFamily>
    <FontFamily x:Key="ThemeMonoFontFamily">Consolas</FontFamily>
    <FontFamily x:Key="ThemeTimerFontFamily">Consolas</FontFamily>
    <Thickness x:Key="ThemeControlBorderThickness">1</Thickness>
    <Thickness x:Key="ThemePanelBorderThickness">1</Thickness>
    <Thickness x:Key="ThemeButtonShadowMargin">0</Thickness>
    <Thickness x:Key="ThemeOverlayPadding">15,8</Thickness>
    <Thickness x:Key="ThemeOverlayFrameBorderThickness">1</Thickness>
    <Thickness x:Key="ThemeOverlayButtonBorderThickness">1</Thickness>
    <CornerRadius x:Key="ThemeControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ThemeItemCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ThemePopupCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="ThemePanelCornerRadius">9</CornerRadius>
    <CornerRadius x:Key="ThemeCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ThemeCheckCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="ThemeOverlayCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ThemeOverlayButtonCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="ThemeTimerPanelCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ThemeDashboardCardCornerRadius">10</CornerRadius>
</ResourceDictionary>
