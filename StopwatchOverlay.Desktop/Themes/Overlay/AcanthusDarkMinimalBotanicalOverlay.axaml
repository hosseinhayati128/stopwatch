<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://StopwatchOverlay.Desktop/Themes/Overlay/OverlayDefaults.axaml" /></ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="OverlayChromeBrush" Color="#252827" />
    <SolidColorBrush x:Key="OverlayChromeBorderBrush" Color="#A68F9E89" />
    <SolidColorBrush x:Key="OverlayToolbarSurfaceBrush" Color="#252827" />
    <SolidColorBrush x:Key="OverlayToolbarBorderBrush" Color="#A68F9E89" />
    <SolidColorBrush x:Key="OverlayActionForegroundBrush" Color="#FBF8F1" />
    <SolidColorBrush x:Key="OverlayHoverBrush" Color="#405447" />
    <SolidColorBrush x:Key="OverlayPressedBrush" Color="#5C745F" />
    <SolidColorBrush x:Key="OverlayInnerRuleBrush" Color="#8F9E89" />
    <SolidColorBrush x:Key="AccentBrush" Color="#8F9E89" />
    <SolidColorBrush x:Key="RecBrush" Color="#8A3E45" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#A68F9E89" />
    <SolidColorBrush x:Key="ActiveItemBorderBrush" Color="#8F9E89" />
    <SolidColorBrush x:Key="OverlayTimerForegroundBrush" Color="#FBF8F1" />
    <SolidColorBrush x:Key="OverlayProjectForegroundBrush" Color="#D5DDCF" />
    <SolidColorBrush x:Key="OverlayActionBackgroundBrush" Color="#303732" />
    <SolidColorBrush x:Key="OverlayActionBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="OverlayCloseBackgroundBrush" Color="#303732" />
    <SolidColorBrush x:Key="OverlayCloseBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="OverlayCloseForegroundBrush" Color="#FBF8F1" />
    <SolidColorBrush x:Key="OverlayCloseHoverForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OverlayPauseBackgroundBrush" Color="#4B6250" />
    <SolidColorBrush x:Key="OverlayPauseBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="OverlayPauseForegroundBrush" Color="#FBF8F1" />
    <SolidColorBrush x:Key="OverlayPauseHoverForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OverlayActionHoverForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OverlayOrnamentBrush" Color="#8F9E89" />
    <SolidColorBrush x:Key="OverlayOrnamentAccentBrush" Color="#8F9E89" />
    <FontFamily x:Key="AppFontFamily">avares://StopwatchOverlay.Desktop/Assets/Fonts/Acanthus/#Inter</FontFamily>
    <FontFamily x:Key="ThemeTimerFontFamily">avares://StopwatchOverlay.Desktop/Assets/Fonts/Acanthus/#Cascadia Mono</FontFamily>
    <Thickness x:Key="ThemeOverlayPadding">24,16,24,12</Thickness>
    <Thickness x:Key="ThemeOverlayFrameBorderThickness">1</Thickness>
    <CornerRadius x:Key="ThemeOverlayCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ThemeOverlayButtonCornerRadius">4</CornerRadius>
    <x:Double x:Key="OverlayActionSize">36</x:Double>
    <Thickness x:Key="OverlayToolbarPadding">4</Thickness>
    <CornerRadius x:Key="OverlayToolbarCornerRadius">7</CornerRadius>
    <x:Double x:Key="OverlayToolbarGap">12</x:Double>
    <x:Double x:Key="OverlayProjectFontSize">14</x:Double>
    <FontWeight x:Key="OverlayProjectFontWeight">Medium</FontWeight>
    <FontWeight x:Key="OverlayTimerFontWeight">SemiBold</FontWeight>
    <Thickness x:Key="OverlayProjectMargin">0,6,0,0</Thickness>
    <x:Double x:Key="OverlayProjectOpacity">1</x:Double>
    <x:Boolean x:Key="OverlayUseThemedChrome">True</x:Boolean>
    <x:Double x:Key="OverlayMinimumWidth">360</x:Double>
</ResourceDictionary>
