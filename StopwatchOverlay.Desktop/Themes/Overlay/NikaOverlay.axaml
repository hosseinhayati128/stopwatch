<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://StopwatchOverlay.Desktop/Themes/Overlay/OverlayDefaults.axaml" />
  </ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="OverlayTimerForegroundBrush" Color="#071C2A" />
  <SolidColorBrush x:Key="OverlayProjectForegroundBrush" Color="#071C2A" />
  <SolidColorBrush x:Key="OverlayActionForegroundBrush" Color="#FFF2D3" />
  <Thickness x:Key="ThemeOverlayPadding">0</Thickness>
  <Thickness x:Key="ThemeOverlayFrameBorderThickness">0</Thickness>
  <x:Double x:Key="OverlayToolbarGap">2</x:Double>
</ResourceDictionary>
