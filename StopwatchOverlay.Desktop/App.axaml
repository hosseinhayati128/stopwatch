<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StopwatchOverlay.Desktop.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://StopwatchOverlay.Desktop/Styles/AppStyles.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://StopwatchOverlay.Desktop/Themes/Midnight.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://StopwatchOverlay.Desktop/Assets/Pirate/icons.png"
                      ToolTipText="Stopwatch Overlay">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open Stopwatch" Click="OnOpenControllerClicked" />
                        <NativeMenuItem Header="Dashboard" Click="OnOpenDashboardClicked" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Exit" Click="OnExitClicked" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
