<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StopwatchOverlay.Desktop.Controls.OverlayDisplaySelector">
    <UserControl.Resources>
        <ControlTheme x:Key="displayChoice" TargetType="RadioButton">
            <Setter Property="Background" Value="#F7E8C8"/>
            <Setter Property="BorderBrush" Value="#C9AC7A"/>
            <Setter Property="Foreground" Value="#102B3B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="MinHeight" Value="57"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="*,6,12">
                            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"
                                              HorizontalContentAlignment="Stretch"/>
                            <Border Name="Ring" Grid.Column="2" Width="12" Height="12" CornerRadius="6"
                                    BorderThickness="1" BorderBrush="#9A835B" VerticalAlignment="Center">
                                <Border Name="Dot" Width="6" Height="6" Background="#F7CE83" CornerRadius="3" IsVisible="False"/>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:checked">
                <Setter Property="Background" Value="#173746"/>
                <Setter Property="BorderBrush" Value="#173746"/>
                <Setter Property="Foreground" Value="#FFF1D1"/>
            </Style>
            <Style Selector="^:checked /template/ Border#Dot"><Setter Property="IsVisible" Value="True"/></Style>
            <Style Selector="^:checked /template/ Border#Ring"><Setter Property="BorderBrush" Value="#E9BF78"/></Style>
            <Style Selector="^:pointerover /template/ Border#Surface"><Setter Property="BorderBrush" Value="#AC813F"/></Style>
            <Style Selector="^:focus-visible /template/ Border#Surface">
                <Setter Property="BorderBrush" Value="#CB820F"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBlock.resolution"><Setter Property="Foreground" Value="#68583D"/></Style>
        <Style Selector="RadioButton:checked TextBlock.resolution"><Setter Property="Foreground" Value="#E5D9BE"/></Style>
        <Style Selector="Border.monitor"><Setter Property="BorderBrush" Value="#446370"/></Style>
        <Style Selector="RadioButton:checked Border.monitor"><Setter Property="BorderBrush" Value="#D3B67E"/></Style>
        <Style Selector="Border.stand"><Setter Property="Background" Value="#446370"/></Style>
        <Style Selector="RadioButton:checked Border.stand"><Setter Property="Background" Value="#D3B67E"/></Style>
    </UserControl.Styles>
    <StackPanel Spacing="5">
        <RadioButton Name="AllDisplays" Content="All displays" MinHeight="33" Theme="{StaticResource displayChoice}"
                     AutomationProperties.Name="All displays"/>
        <UniformGrid Name="Monitors" Columns="2" Margin="-3,0,-3,0"/>
    </StackPanel>
</UserControl>
