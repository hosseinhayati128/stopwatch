<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:StopwatchOverlay.Desktop.Controls">
    <Styles.Resources>
        <LinearGradientBrush x:Key="NikaBrassRule" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ECD5A4" Offset="0"/><GradientStop Color="#B89255" Offset="0.48"/><GradientStop Color="#D3B477" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NikaNavyPlate" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#07354C" Offset="0"/><GradientStop Color="#00263A" Offset="0.55"/><GradientStop Color="#001E30" Offset="1"/>
        </LinearGradientBrush>
        <DataTemplate x:Key="NikaActionContent" x:CompileBindings="False">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <controls:NikaActionIcon Label="{Binding}" Ink="{Binding $parent[Button].Foreground}" Width="24" Height="24" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Styles.Resources>
    <Style Selector="Window.nika Button.mainAction, Window.nika Button.editAction, Window.nika Button.topAction, Window.nika Button.renameProject">
        <Setter Property="ContentTemplate" Value="{StaticResource NikaActionContent}"/>
    </Style>
    <Style Selector=":is(Control).nikaOnly"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Window.nika :is(Control).nikaOnly"><Setter Property="IsVisible" Value="True"/></Style>
    <Style Selector="Window.nika"><Setter Property="Background" Value="#032437"/></Style>
    <Style Selector="Window.nika Border.header"><Setter Property="Background" Value="#032437"/><Setter Property="BorderBrush" Value="#C49A51"/><Setter Property="Padding" Value="22,12,22,4"/></Style>
    <Style Selector="Window.nika TextBlock.brandTitle"><Setter Property="Text" Value="Stopwatch Controller"/><Setter Property="FontFamily" Value="{DynamicResource NikaHeadingFont}"/><Setter Property="FontSize" Value="34"/><Setter Property="Foreground" Value="#FFF1D9"/></Style>
    <Style Selector="Window.nika TextBlock.nikaBrandCaption"><Setter Property="Foreground" Value="#E8B34F"/><Setter Property="FontSize" Value="9"/></Style>
    <Style Selector="Window.nika Path.brandIcon"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Window.nika Menu.controllerMenu"><Setter Property="Background" Value="#032437"/><Setter Property="Foreground" Value="#FFF1D9"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="Window.nika MenuItem"><Setter Property="Foreground" Value="#FFF1D9"/><Setter Property="Background" Value="#032437"/></Style>
    <Style Selector="Window.nika MenuItem /template/ ContentPresenter"><Setter Property="Foreground" Value="#FFF1D9"/></Style>
    <Style Selector="Window.nika MenuItem:pointerover /template/ ContentPresenter"><Setter Property="Foreground" Value="#FFF1D9"/></Style>
    <Style Selector="Window.nika MenuItem /template/ Border"><Setter Property="Background" Value="#032437"/></Style>
    <Style Selector="Window.nika MenuItem:pointerover /template/ Border"><Setter Property="Background" Value="#23556A"/></Style>
    <Style Selector="Window.nika Border.rail"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="16,16,16,12"/><Setter Property="BorderBrush" Value="#B3BC985E"/><Setter Property="BorderThickness" Value="0,0,1.5,0"/></Style>
    <Style Selector="Window.nika TextBlock.railHeading"><Setter Property="FontFamily" Value="{DynamicResource NikaHeadingFont}"/><Setter Property="FontSize" Value="30"/><Setter Property="Foreground" Value="#FFF1D9"/></Style>
    <Style Selector="Window.nika TextBlock.railName"><Setter Property="FontFamily" Value="{DynamicResource NikaHeadingFont}"/><Setter Property="FontSize" Value="23"/><Setter Property="Foreground" Value="#FFF1D9"/></Style>
    <Style Selector="Window.nika TextBlock.railSummary"><Setter Property="Foreground" Value="#D4E0E6"/><Setter Property="Opacity" Value="1"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="Window.nika TextBlock.railStatus"><Setter Property="Foreground" Value="#E9BD69"/><Setter Property="Opacity" Value="1"/></Style>
    <Style Selector="Window.nika Border.railCard"><Setter Property="Background" Value="#55032437"/><Setter Property="BorderBrush" Value="#436072"/><Setter Property="Padding" Value="12,6"/></Style>
    <Style Selector="Window.nika ListBox#TimerRailList ListBoxItem"><Setter Property="Padding" Value="2"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><ControlTemplate><Border Name="NikaCard" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,1,1,1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch"/></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="Window.nika ListBox#TimerRailList ListBoxItem:selected /template/ Border#NikaCard"><Setter Property="BorderBrush" Value="#F0B741"/><Setter Property="Background" Value="#134257"/></Style>
    <Style Selector="Window.nika ListBox#TimerRailList ListBoxItem:pointerover /template/ Border#NikaCard"><Setter Property="Background" Value="#205166"/></Style>
    <Style Selector="Window.nika ListBox#TimerRailList ListBoxItem:focus-visible /template/ Border#NikaCard"><Setter Property="BorderBrush" Value="#FFE0A0"/></Style>
    <Style Selector="Window.nika Grid.workspace"><Setter Property="Margin" Value="28,20,24,0"/></Style>
    <Style Selector="Window.nika Grid.workspaceTitleRow"><Setter Property="MinHeight" Value="104"/></Style>
    <Style Selector="Window.nika TextBlock.nikaEyebrow"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="LetterSpacing" Value="3"/><Setter Property="Foreground" Value="#896331"/></Style>
    <Style Selector="Window.nika TextBlock.workspaceTitle"><Setter Property="FontFamily" Value="{DynamicResource NikaHeadingFont}"/><Setter Property="FontSize" Value="64"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="MaxWidth" Value="430"/></Style>
    <Style Selector="Window.nika Border.hero"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,12,12,20"/><Setter Property="Margin" Value="0,10,0,20"/></Style>
    <Style Selector="Window.nika TextBlock.timeDisplay"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Window.nika Viewbox.nikaTimer"><Setter Property="MaxHeight" Value="165"/></Style>
    <Style Selector="Window.nika TextBlock#ProjectSubtitle"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Window.nika StackPanel.modeSelector"><Setter Property="Spacing" Value="0"/></Style>
    <Style Selector="Window.nika RadioButton"><Setter Property="FontSize" Value="14"/></Style>
    <Style Selector="Window.nika StackPanel.modeSelector RadioButton"><Setter Property="Padding" Value="20,7"/><Setter Property="Background" Value="#30D5B47A"/><Setter Property="BorderBrush" Value="#AA8A52"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template"><ControlTemplate><Border Name="NikaMode" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="Window.nika StackPanel.modeSelector RadioButton:checked"><Setter Property="Background" Value="#032437"/><Setter Property="Foreground" Value="#FFF1D9"/></Style>
    <Style Selector="Window.nika StackPanel.modeSelector RadioButton:pointerover /template/ Border#NikaMode"><Setter Property="BorderBrush" Value="#705225"/></Style>
    <Style Selector="Window.nika StackPanel.modeSelector RadioButton:focus-visible /template/ Border#NikaMode"><Setter Property="BorderThickness" Value="2"/><Setter Property="BorderBrush" Value="#C75A2C"/></Style>
    <Style Selector="Window.nika Button"><Setter Property="Background" Value="#032B40"/><Setter Property="Foreground" Value="#FFF1D9"/><Setter Property="BorderBrush" Value="#C7A465"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Template"><ControlTemplate><Border Name="NikaButtonPlate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" RecognizesAccessKey="True"/></Border></ControlTemplate></Setter>
    </Style>
