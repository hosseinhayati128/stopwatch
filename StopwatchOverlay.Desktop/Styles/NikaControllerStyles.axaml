    <Style Selector="Window.nika.short Grid.workspaceTitleRow"><Setter Property="MinHeight" Value="66"/></Style>
    <Style Selector="Window.nika.short Grid.workspace"><Setter Property="Margin" Value="24,10,24,0"/></Style>
    <Style Selector="Window.nika.short Viewbox.nikaTimer"><Setter Property="MaxHeight" Value="120"/></Style>
    <Style Selector="Window.nika.short Border.hero"><Setter Property="Padding" Value="8,4,8,10"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style Selector="Window.nika.short Border.laps"><Setter Property="MinHeight" Value="100"/><Setter Property="MaxHeight" Value="160"/></Style>

    <!-- The enhanced palette and layout are deliberately limited to this controller. -->
    <Style Selector="Window.nika Grid#ControllerFrame"><Setter Property="Margin" Value="0"/><Setter Property="ClipToBounds" Value="True"/></Style>
