<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:StopwatchOverlay.Desktop.Controls">
    <Styles.Resources>
        <LinearGradientBrush x:Key="NikaBrassRule" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ECD5A4" Offset="0"/><GradientStop Color="#B89255" Offset="0.48"/><GradientStop Color="#D3B477" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NikaNavyPlate" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#07354C" Offset="0"/><GradientStop Color="#00263A" Offset="0.55"/><GradientStop Color="#001E30" Offset="1"/>
        </LinearGradientBrush>
        <DataTemplate x:Key="NikaActionContent" x:CompileBindings="False">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <controls:NikaActionIcon Label="{Binding}" Ink="{Binding $parent[Button].Foreground}" Width="24" Height="24" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Styles.Resources>
    <Style Selector="Window.nika Button.topAction">
        <Setter Property="ContentTemplate" Value="{StaticResource NikaActionContent}"/>
    </Style>
    <Style Selector=":is(Control).nikaOnly"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Window.nika :is(Control).nikaOnly"><Setter Property="IsVisible" Value="True"/></Style>
    <Style Selector="Window.nika"><Setter Property="Background" Value="#032437"/></Style>
    <Style Selector="Window.nika Border.header"><Setter Property="Background" Value="#032437"/><Setter Property="BorderBrush" Value="#C49A51"/><Setter Property="Padding" Value="22,12,22,4"/></Style>
    <Style Selector="Window.nika TextBlock.brandTitle"><Setter Property="Text" Value="Stopwatch Controller"/><Setter Property="FontFamily" Value="{DynamicResource NikaHeadingFont}"/><Setter Property="FontSize" Value="34"/><Setter Property="Foreground" Value="#FFF1D9"/></Style>
    <Style Selector="Window.nika TextBlock.nikaBrandCaption"><Setter Property="Foreground" Value="#E8B34F"/><Setter Property="FontSize" Value="9"/></Style>
    <Style Selector="Window.nika Path.brandIcon"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Window.nika Menu.controllerMenu"><Setter Property="Background" Value="#032437"/><Setter Property="Foreground" Value="#FFF1D9"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="Window.nika MenuItem:not(.timerAction)"><Setter Property="Foreground" Value="#FFF1D9"/><Setter Property="Background" Value="#032437"/></Style>
    <Style Selector="Window.nika MenuItem:not(.timerAction) /template/ ContentPresenter"><Setter Property="Foreground" Value="#FFF1D9"/></Style>
    <Style Selector="Window.nika MenuItem:not(.timerAction):pointerover /template/ ContentPresenter"><Setter Property="Foreground" Value="#FFF1D9"/></Style>
    <Style Selector="Window.nika MenuItem:not(.timerAction) /template/ Border"><Setter Property="Background" Value="#032437"/></Style>
    <Style Selector="Window.nika MenuItem:not(.timerAction):pointerover /template/ Border"><Setter Property="Background" Value="#23556A"/></Style>
    <Style Selector="Window.nika Border.rail"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="16,16,16,12"/><Setter Property="BorderBrush" Value="#B3BC985E"/><Setter Property="BorderThickness" Value="0,0,1.5,0"/></Style>
    <Style Selector="Window.nika TextBlock.railHeading"><Setter Property="FontFamily" Value="{DynamicResource NikaHeadingFont}"/><Setter Property="FontSize" Value="30"/><Setter Property="Foreground" Value="#FFF1D9"/></Style>
    <Style Selector="Window.nika TextBlock.railStatus"><Setter Property="Foreground" Value="#E9BD69"/><Setter Property="Opacity" Value="1"/></Style>
    <Style Selector="Window.nika Grid.workspace"><Setter Property="Margin" Value="28,20,24,0"/></Style>
    <Style Selector="Window.nika TextBlock.timeDisplay"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Window.nika TextBlock#ProjectSubtitle"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Window.nika RadioButton"><Setter Property="FontSize" Value="14"/></Style>
    <Style Selector="Window.nika Button"><Setter Property="Background" Value="#032B40"/><Setter Property="Foreground" Value="#FFF1D9"/><Setter Property="BorderBrush" Value="#C7A465"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Template"><ControlTemplate><Border Name="NikaButtonPlate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" RecognizesAccessKey="True"/></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="Window.nika Button.topAction"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,8"/></Style>
    <Style Selector="Window.nika Button.railNew"><Setter Property="Background" Value="Transparent"/><Setter Property="Height" Value="44"/><Setter Property="FontFamily" Value="{DynamicResource NikaHeadingFont}"/><Setter Property="FontSize" Value="23"/></Style>
    <Style Selector="Window.nika Button:pointerover /template/ Border#NikaButtonPlate"><Setter Property="Background" Value="#23556A"/><Setter Property="BorderBrush" Value="#FFD68B"/></Style>
    <Style Selector="Window.nika Button:pressed /template/ Border#NikaButtonPlate"><Setter Property="Opacity" Value="0.7"/></Style>
    <Style Selector="Window.nika Button.modern:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#FFF1D9"/></Style>
    <Style Selector="Window.nika Button.modern:pressed /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#FFF1D9"/></Style>
    <Style Selector="Window.nika Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#FFF1D9"/></Style>
    <Style Selector="Window.nika Button.primary:pressed /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#FFF1D9"/></Style>
    <Style Selector="Window.nika Button:focus-visible /template/ Border#NikaButtonPlate"><Setter Property="BorderBrush" Value="#F9B946"/><Setter Property="BorderThickness" Value="3"/></Style>
    <Style Selector="Window.nika Button:disabled"><Setter Property="Opacity" Value="0.5"/></Style>
    <Style Selector="Window.nika Border.status"><Setter Property="Background" Value="#032437"/><Setter Property="Margin" Value="-28,14,-24,0"/><Setter Property="Padding" Value="18,12"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Window.nika Border.status"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Window.nika Border.status TextBlock"><Setter Property="Foreground" Value="#FFF1D9"/><Setter Property="Opacity" Value="1"/></Style>
    <Style Selector="Window.nika.compact Grid.workspace"><Setter Property="Margin" Value="14,14,14,0"/></Style>
    <Style Selector="Window.nika.compact TextBlock.brandTitle"><Setter Property="FontSize" Value="26"/></Style>
    <Style Selector="Window.nika.compact TextBlock.nikaBrandCaption"><Setter Property="FontSize" Value="7"/></Style>
    <Style Selector="Window.nika.compact Border.status"><Setter Property="Margin" Value="-14,14,-14,0"/></Style>
    <Style Selector="Window.nika.compact Border.status TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="MaxWidth" Value="180"/></Style>
    <Style Selector="Window.nika.compact Border.nikaFooter TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="MaxWidth" Value="200"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="Window.nika.short Grid.workspace"><Setter Property="Margin" Value="24,10,24,0"/></Style>

    <!-- The enhanced palette and layout are deliberately limited to this controller. -->
    <Style Selector="Window.nika Grid#ControllerFrame"><Setter Property="Margin" Value="0"/><Setter Property="ClipToBounds" Value="True"/></Style>
    <Style Selector="Window.nika Border.header"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Window.nika Menu.controllerMenu"><Setter Property="(Grid.Row)" Value="0"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,26,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/></Style>
    <Style Selector="Window.nika MenuItem.legacyMenu"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Window.nika Border.rail"><Setter Property="Padding" Value="16,18,16,22"/></Style>
    <Style Selector="Window.nika TextBlock.railHeading"><Setter Property="FontSize" Value="34"/><Setter Property="FontWeight" Value="ExtraBold"/><Setter Property="Height" Value="48"/></Style>
    <Style Selector="Window.nika Button.railNew"><Setter Property="Height" Value="52"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="Window.nika TextBlock.railStatus"><Setter Property="FontSize" Value="13"/><Setter Property="LetterSpacing" Value="2"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
    <Style Selector="Window.nika Grid.workspace"><Setter Property="Margin" Value="28,20,28,0"/></Style>
    <Style Selector="Window.nika Button.railNew"><Setter Property="BorderBrush" Value="{StaticResource NikaBrassRule}"/><Setter Property="Background" Value="{StaticResource NikaNavyPlate}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Window.nika Border.status"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Window.nika.compact Grid#ControllerFrame"><Setter Property="Margin" Value="6"/></Style>
    <Style Selector="Window.nika.compact Border.nikaHeader"><Setter Property="Padding" Value="12,8,70,8"/><Setter Property="Height" Value="86"/></Style>
    <Style Selector="Window.nika.compact StackPanel.nikaHeaderNav"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Window.nika.compact Menu.controllerMenu"><Setter Property="Margin" Value="0,0,10,0"/></Style>
    <Style Selector="Window.nika.compact Grid.workspace"><Setter Property="Margin" Value="12,12,12,0"/></Style>
    <Style Selector="Window.nika.compact Border.nikaFooter StackPanel"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Window.nika Button.topAction"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="Medium"/></Style>
    <Style Selector="Window.nika Grid.railHeadingRow"><Setter Property="Margin" Value="10,0,10,8"/></Style>
    <Style Selector="Window.nika Button.nikaWindowControl"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="42"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="23"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Window.nika.compact StackPanel.nikaHeaderBrand > TextBlock"><Setter Property="FontSize" Value="22"/></Style>
    <Style Selector="Window.nika TextBlock.nikaHeaderTitle"><Setter Property="FontSize" Value="42"/></Style>
    <Style Selector="Window.nika.compact TextBlock.nikaHeaderTitle"><Setter Property="FontSize" Value="22"/></Style>
    <Style Selector="Window.nika.compact TextBlock.nikaHeaderCaption"><Setter Property="IsVisible" Value="False"/></Style>
</Styles>
