    <Style Selector="Window.nika Button:pressed /template/ Border#NikaButtonPlate"><Setter Property="Opacity" Value="0.7"/></Style>
    <Style Selector="Window.nika Button.modern:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#FFF1D9"/></Style>
