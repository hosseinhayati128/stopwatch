<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StopwatchOverlay.Desktop.Views.CloseActionDialogWindow"
        Title="Close Stopwatch"
        Width="520"
        MinWidth="420"
        SizeToContent="Height"
        MaxHeight="780"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Styles>
        <StyleInclude Source="/Styles/PirateControllerStyles.axaml"/>
    </Window.Styles>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Margin="18"
                Background="{DynamicResource DialogSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{DynamicResource ThemePanelBorderThickness}"
                CornerRadius="{DynamicResource ThemePanelCornerRadius}"
                BoxShadow="0 6 20 0 #40000000">
            <StackPanel Margin="24">
                <!-- Heading -->
                <TextBlock x:Name="HeadingText"
                           Text="Close Stopwatch"
                           Classes="heading"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />

                <!-- Message -->
                <TextBlock x:Name="MessageText"
                           Margin="0,10,0,8"
                           Text="Do you want to minimize the app to the system tray, or close it completely?"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontSize="14" />

                <!-- Detail / Explanation -->
                <TextBlock Text="When minimized to the tray, stopwatch timers, floating overlays, and shortcuts stay active in the background."
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontSize="12"
                           Margin="0,0,0,18" />

                <!-- Remember Choice CheckBox -->
                <CheckBox x:Name="RememberCheck"
                          Content="Remember my choice"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,22" />

                <StackPanel Spacing="8">
                    <Button x:Name="MinimizeButton"
                            Content="Minimize to Tray"
                            MinWidth="136"
                            HorizontalAlignment="Stretch"
                            Classes="primary topAction"
                            Click="OnMinimizeClicked" />
                    <Button x:Name="ExitButton"
                            Content="Close Completely"
                            MinWidth="136"
                            HorizontalAlignment="Stretch"
                            Classes="danger topAction"
                            Click="OnExitClicked" />
                    <Button Content="Cancel"
                            MinWidth="80"
                            HorizontalAlignment="Stretch"
                            Classes="modern topAction"
                            Click="OnCancelClicked" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
