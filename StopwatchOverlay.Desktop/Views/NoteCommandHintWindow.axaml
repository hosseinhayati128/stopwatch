<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StopwatchOverlay.Desktop.Views.NoteCommandHintWindow"
        Title="Note Command Mode"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        CanResize="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight">
    <Border Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="{DynamicResource ThemePanelBorderThickness}"
            CornerRadius="{DynamicResource ThemePanelCornerRadius}"
            Padding="16,10"
            Margin="8"
            BoxShadow="0 4 14 0 #55000000">
        <StackPanel HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4" Spacing="4">
                <TextBlock Text="✦ " Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="Note Options:"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Text="1 Todo · 2 Quick Note · 3 Reminder · 4 View Notes"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontSize="12"
                       FontWeight="Medium"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Press key to select · Esc to cancel"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Margin="0,3,0,0"/>
        </StackPanel>
    </Border>
</Window>
