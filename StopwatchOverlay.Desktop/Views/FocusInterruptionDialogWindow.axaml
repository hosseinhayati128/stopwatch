<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StopwatchOverlay.Desktop.Views.FocusInterruptionDialogWindow"
        Title="Focus Check-in"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">
    <Border Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="{DynamicResource ThemePanelBorderThickness}"
            CornerRadius="{DynamicResource ThemePanelCornerRadius}"
            Padding="22,18"
            Margin="16"
            MinWidth="380"
            MaxWidth="460"
            BoxShadow="0 8 28 0 #77000000">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Spacing="4">
                <TextBlock Text="✦ " Foreground="{DynamicResource AccentBrush}" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="Focus Check-in"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="15"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Subtitle: Pause details -->
            <TextBlock x:Name="PauseSummaryText"
                       Text="Paused for 3m 12s on Project"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontSize="13"
                       FontWeight="Medium"
                       TextWrapping="Wrap"
                       Margin="0,0,0,2"/>

            <TextBlock Text="What was the reason for this pause?"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="11.5"
                       Margin="0,0,0,14"/>

            <!-- Option 1: Valid Break -->
            <Button x:Name="ValidBreakButton" Classes="choice" Click="OnValidBreakClicked">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="keyBadge">
                        <TextBlock Text="1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="☕  Valid Break / Stepped Away" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Planned break, restroom, call, errand" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Option 2: Distraction -->
            <Button x:Name="DistractionButton" Classes="choice" Click="OnDistractionClicked">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Classes="keyBadge">
                        <TextBlock Text="2" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="⚡  Distraction" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Checking phone, social media, lost focus" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <Border x:Name="SuggestedBadge" Grid.Column="2" VerticalAlignment="Center"
                            Background="#33FB923C" BorderBrush="#FB923C" BorderThickness="1"
                            CornerRadius="3" Padding="6,2" IsVisible="False">
                        <TextBlock Text="&lt; 5m default" FontSize="10" FontWeight="SemiBold" Foreground="#FB923C"/>
                    </Border>
                </Grid>
            </Button>

            <!-- Option 3: Quick Idea / Brainstorming -->
            <Button x:Name="IdeaButton" Classes="choice" Click="OnIdeaClicked">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="keyBadge">
                        <TextBlock Text="3" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="💡  Idea / Brainstorming" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Jotting down an idea to clear mind and refocus" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Option 4: Switch Between Tasks -->
            <Button x:Name="TaskSwitchButton" Classes="choice" Click="OnTaskSwitchClicked">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Classes="keyBadge">
                        <TextBlock Text="4" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="TaskSwitchTitleText" Text="🔀  Switch Between Tasks" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="TaskSwitchSubText" Text="Switched to another project or active timer" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <Border x:Name="TaskSwitchDefaultBadge" Grid.Column="2" VerticalAlignment="Center"
                            Background="#3338BDF8" BorderBrush="#38BDF8" BorderThickness="1"
                            CornerRadius="3" Padding="6,2" IsVisible="False">
                        <TextBlock Text="Task switch default" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </Border>
                </Grid>
            </Button>

            <!-- Footer hint & countdown -->
            <Grid Margin="0,6,0,0">
                <TextBlock x:Name="FooterHintText"
                           Text="Press 1, 2, 3, or 4 · Esc to skip"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="11"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="CountdownText"
                           Text="Closing in 12s"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="11"
                           HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
