<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StopwatchOverlay.Desktop.Views.MainWindow"
        Title="Stopwatch Overlay"
        Width="520" Height="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Classes="heading" Text="Stopwatch Overlay" />
            <TextBlock Classes="subheading" Text="Cross-Platform Desktop (Windows &amp; Linux)" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ThemeControlCornerRadius}"
                Margin="0,20" Padding="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <TextBlock Classes="timer" FontSize="52" Text="00:00:00" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <Button Classes="primary" Content="Start / Pause" />
                    <Button Classes="modern" Content="Reset" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Classes="modern" Content="Dashboard" />
            <Button Classes="modern" Content="Settings" />
        </StackPanel>
    </Grid>
</Window>
