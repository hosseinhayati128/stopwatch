<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StopwatchOverlay.Desktop.Views.ShortcutsWindow"
        Title="Keyboard Shortcuts"
        Width="540" Height="680" MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Margin="20" Padding="20"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ThemeCardCornerRadius}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
                
                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Classes="heading" Text="Keyboard Shortcuts" HorizontalAlignment="Center" />
                    <TextBlock Text="Click a shortcut box and press a key combination. Pressing the leader enters command mode."
                               TextWrapping="Wrap" Opacity="0.75" TextAlignment="Center" MaxWidth="440"/>
                </StackPanel>

                <!-- Leader shortcut row -->
                <Grid Grid.Row="1" ColumnDefinitions="160,*,Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0" Text="Timer leader shortcut:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="LeaderShortcutBox" Tag="CommandLeader" IsReadOnly="True" Margin="0,0,8,0"
                             GotFocus="ShortcutBox_GotFocus" LostFocus="ShortcutBox_LostFocus" KeyDown="ShortcutBox_KeyDown"/>
                    <Button Grid.Column="2" Content="Clear" Tag="CommandLeader" Click="ClearShortcut_Click" Classes="modern"/>
                </Grid>

                <!-- Note menu shortcut row -->
                <Grid Grid.Row="2" ColumnDefinitions="160,*,Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0" Text="Note menu shortcut:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="NoteLeaderShortcutBox" Tag="NoteLeader" IsReadOnly="True" Margin="0,0,8,0"
                             GotFocus="ShortcutBox_GotFocus" LostFocus="ShortcutBox_LostFocus" KeyDown="ShortcutBox_KeyDown"/>
                    <Button Grid.Column="2" Content="Clear" Tag="NoteLeader" Click="ClearShortcut_Click" Classes="modern"/>
                </Grid>

                <!-- Show active overlay shortcut row -->
                <Grid Grid.Row="3" ColumnDefinitions="160,*,Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0" Text="Show active overlay:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="ShowActiveOverlayShortcutBox" Tag="ShowActiveOverlay" IsReadOnly="True" Margin="0,0,8,0"
                             GotFocus="ShortcutBox_GotFocus" LostFocus="ShortcutBox_LostFocus" KeyDown="ShortcutBox_KeyDown"/>
                    <Button Grid.Column="2" Content="Clear" Tag="ShowActiveOverlay" Click="ClearShortcut_Click" Classes="modern"/>
                </Grid>

                <!-- Open controller shortcut row -->
                <Grid Grid.Row="4" ColumnDefinitions="160,*,Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0" Text="Open controller:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="OpenControllerShortcutBox" Tag="OpenController" IsReadOnly="True" Margin="0,0,8,0"
                             GotFocus="ShortcutBox_GotFocus" LostFocus="ShortcutBox_LostFocus" KeyDown="ShortcutBox_KeyDown"/>
                    <Button Grid.Column="2" Content="Clear" Tag="OpenController" Click="ClearShortcut_Click" Classes="modern"/>
                </Grid>

                <!-- Chaining timeout row -->
                <Grid Grid.Row="5" ColumnDefinitions="160,*,60" Margin="0,0,0,16">
                    <TextBlock Grid.Column="0" Text="Chaining timeout:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="ChainingTimeoutSlider" Minimum="0.2" Maximum="2.0"
                            Value="0.5" VerticalAlignment="Center" Margin="0,0,8,0"
                            ValueChanged="ChainingTimeoutSlider_ValueChanged"/>
                    <TextBlock Grid.Column="2" x:Name="ChainingTimeoutText" Text="0.5 s" VerticalAlignment="Center" TextAlignment="Right"/>
                </Grid>

                <!-- Command Mode Reference Table -->
                <Border Grid.Row="6" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource SubtleDividerBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12" Margin="0,0,0,16">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="Command mode keys (fixed):" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                        <ScrollViewer Grid.Row="1" MaxHeight="180" VerticalScrollBarVisibility="Auto">
                            <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Space" FontWeight="Bold" Margin="0,3,8,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Start or stop the active timer" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="R" FontWeight="Bold" Margin="0,3,8,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Reset the active timer" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="O" FontWeight="Bold" Margin="0,3,8,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Show or hide the active timer overlay" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="L" FontWeight="Bold" Margin="0,3,8,3"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Record a lap" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="C" FontWeight="Bold" Margin="0,3,8,3"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Toggle between current mode and Clock" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="N" FontWeight="Bold" Margin="0,3,8,3"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Create a new timer and make it active" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="T" FontWeight="Bold" Margin="0,3,8,3"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="Select the next active timer" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="X" FontWeight="Bold" Margin="0,3,8,3"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="Close the active timer" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="P" FontWeight="Bold" Margin="0,3,8,3"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="Select, create, change, or clear project" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="9" Grid.Column="0" Text="D" FontWeight="Bold" Margin="0,3,8,3"/>
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="Open project time dashboard" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="10" Grid.Column="0" Text="W" FontWeight="Bold" Margin="0,3,8,3"/>
                                <TextBlock Grid.Row="10" Grid.Column="1" Text="Open stopwatch controller" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="11" Grid.Column="0" Text="E" FontWeight="Bold" Margin="0,3,8,3"/>
                                <TextBlock Grid.Row="11" Grid.Column="1" Text="Edit active timer (adjust value, start time)" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="12" Grid.Column="0" Text="A" FontWeight="Bold" Margin="0,3,8,3"/>
                                <TextBlock Grid.Row="12" Grid.Column="1" Text="Add a new completed project record" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="13" Grid.Column="0" Text="S" FontWeight="Bold" Margin="0,3,8,3"/>
                                <TextBlock Grid.Row="13" Grid.Column="1" Text="Sync ActivityWatch log to Obsidian now" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="14" Grid.Column="0" Text="B" FontWeight="Bold" Margin="0,3,8,3"/>
                                <TextBlock Grid.Row="14" Grid.Column="1" Text="Separate active timer onto its own clock overlay" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="15" Grid.Column="0" Text="M" FontWeight="Bold" Margin="0,3,8,3"/>
                                <TextBlock Grid.Row="15" Grid.Column="1" Text="Merge active separated overlay back into herd" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="16" Grid.Column="0" Text="Tab / J" FontWeight="Bold" Margin="0,3,8,3"/>
                                <TextBlock Grid.Row="16" Grid.Column="1" Text="Switch between separated clock overlays" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="17" Grid.Column="0" Text="Escape" FontWeight="Bold" Margin="0,3,8,3"/>
                                <TextBlock Grid.Row="17" Grid.Column="1" Text="Cancel command mode without action" Margin="0,3,0,3"/>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="Reset to defaults" Click="ResetDefaults_Click" Classes="modern"/>
                    <Button Content="Cancel" Click="Cancel_Click" Classes="modern" MinWidth="80"/>
                    <Button Content="Save" Click="Save_Click" Classes="primary" MinWidth="80"/>
                </StackPanel>

            </Grid>
        </Border>
    </ScrollViewer>
</Window>
