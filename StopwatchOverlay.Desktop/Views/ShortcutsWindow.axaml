<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StopwatchOverlay.Desktop.Views.ShortcutsWindow"
        Title="Keyboard Shortcuts"
        Width="560" Height="730" MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Margin="18" Padding="18"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ThemeCardCornerRadius}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
                
                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14" Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Classes="heading" Text="Keyboard Shortcuts" HorizontalAlignment="Center" />
                    <TextBlock Text="Configure global leader shortcuts and custom command mode keys."
                               TextWrapping="Wrap" Opacity="0.75" TextAlignment="Center" MaxWidth="440"/>
                </StackPanel>

                <!-- Leader shortcut row -->
                <Grid Grid.Row="1" ColumnDefinitions="160,*,Auto" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Text="Timer leader shortcut:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="LeaderShortcutBox" Tag="CommandLeader" IsReadOnly="True" Margin="0,0,8,0"
                             GotFocus="ShortcutBox_GotFocus" LostFocus="ShortcutBox_LostFocus" KeyDown="ShortcutBox_KeyDown"/>
                    <Button Grid.Column="2" Content="Clear" Tag="CommandLeader" Click="ClearShortcut_Click" Classes="modern"/>
                </Grid>

                <!-- Note menu shortcut row -->
                <Grid Grid.Row="2" ColumnDefinitions="160,*,Auto" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Text="Note menu shortcut:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="NoteLeaderShortcutBox" Tag="NoteLeader" IsReadOnly="True" Margin="0,0,8,0"
                             GotFocus="ShortcutBox_GotFocus" LostFocus="ShortcutBox_LostFocus" KeyDown="ShortcutBox_KeyDown"/>
                    <Button Grid.Column="2" Content="Clear" Tag="NoteLeader" Click="ClearShortcut_Click" Classes="modern"/>
                </Grid>

                <!-- Show active overlay shortcut row -->
                <Grid Grid.Row="3" ColumnDefinitions="160,*,Auto" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Text="Show active overlay:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="ShowActiveOverlayShortcutBox" Tag="ShowActiveOverlay" IsReadOnly="True" Margin="0,0,8,0"
                             GotFocus="ShortcutBox_GotFocus" LostFocus="ShortcutBox_LostFocus" KeyDown="ShortcutBox_KeyDown"/>
                    <Button Grid.Column="2" Content="Clear" Tag="ShowActiveOverlay" Click="ClearShortcut_Click" Classes="modern"/>
                </Grid>

                <!-- Open controller shortcut row -->
                <Grid Grid.Row="4" ColumnDefinitions="160,*,Auto" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Text="Open controller:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="OpenControllerShortcutBox" Tag="OpenController" IsReadOnly="True" Margin="0,0,8,0"
                             GotFocus="ShortcutBox_GotFocus" LostFocus="ShortcutBox_LostFocus" KeyDown="ShortcutBox_KeyDown"/>
                    <Button Grid.Column="2" Content="Clear" Tag="OpenController" Click="ClearShortcut_Click" Classes="modern"/>
                </Grid>

                <!-- Chaining timeout row -->
                <Grid Grid.Row="5" ColumnDefinitions="160,*,60" Margin="0,0,0,12">
                    <TextBlock Grid.Column="0" Text="Chaining timeout:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="ChainingTimeoutSlider" Minimum="0.2" Maximum="2.0"
                            Value="0.5" VerticalAlignment="Center" Margin="0,0,8,0"
                            ValueChanged="ChainingTimeoutSlider_ValueChanged"/>
                    <TextBlock Grid.Column="2" x:Name="ChainingTimeoutText" Text="0.5 s" VerticalAlignment="Center" TextAlignment="Right"/>
                </Grid>

                <!-- Tabs for Win+F2 and Win+F3 Commands -->
                <TabControl Grid.Row="6" x:Name="CommandsTabControl" Margin="0,0,0,16">
                    <!-- Win + F2 Commands Tab -->
                    <TabItem Header="Win + F2 Commands">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource SubtleDividerBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12" Margin="0,8,0,0">
                            <Grid RowDefinitions="Auto,Auto,*,Auto">
                                <TextBlock Grid.Row="0" Text="Timer command mode keys (click box and press a key to rebind):" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                <Border Grid.Row="1" x:Name="WinF2ValidationWarningBorder" Background="#26FF453A" BorderBrush="#FF453A"
                                        BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,6" IsVisible="False">
                                    <TextBlock x:Name="WinF2ValidationWarning" Foreground="#FF453A" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Border>
                                <ScrollViewer Grid.Row="2" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="WinF2CommandsPanel" Spacing="4"/>
                                </ScrollViewer>
                                <TextBlock Grid.Row="3" Text="Escape: Cancel command mode (fixed)"
                                           Opacity="0.7" FontSize="11" Margin="0,6,0,0"/>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- Win + F3 Commands Tab -->
                    <TabItem Header="Win + F3 Commands">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource SubtleDividerBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12" Margin="0,8,0,0">
                            <Grid RowDefinitions="Auto,Auto,*,Auto">
                                <TextBlock Grid.Row="0" Text="Note command mode keys (click box and press a key to rebind):" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                <Border Grid.Row="1" x:Name="WinF3ValidationWarningBorder" Background="#26FF453A" BorderBrush="#FF453A"
                                        BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,6" IsVisible="False">
                                    <TextBlock x:Name="WinF3ValidationWarning" Foreground="#FF453A" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Border>
                                <ScrollViewer Grid.Row="2" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="WinF3CommandsPanel" Spacing="4"/>
                                </ScrollViewer>
                                <TextBlock Grid.Row="3" Text="Escape: Cancel command mode (fixed)"
                                           Opacity="0.7" FontSize="11" Margin="0,6,0,0"/>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="Reset to defaults" Click="ResetDefaults_Click" Classes="modern"/>
                    <Button Content="Cancel" Click="Cancel_Click" Classes="modern" MinWidth="80"/>
                    <Button Content="Save" Click="Save_Click" Classes="primary" MinWidth="80"/>
                </StackPanel>

            </Grid>
        </Border>
    </ScrollViewer>
</Window>
