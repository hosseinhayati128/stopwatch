<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StopwatchOverlay.Desktop.Views.TimerNameWindow"
        Title="Choose project"
        Width="520" MinWidth="380"
        SizeToContent="Height" MaxHeight="780"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Margin="18"
                Background="{DynamicResource DialogSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{DynamicResource ThemePanelBorderThickness}"
                CornerRadius="{DynamicResource ThemePanelCornerRadius}"
                BoxShadow="0 6 20 0 #40000000">
            <StackPanel Margin="24">
                <TextBlock x:Name="HeadingText"
                           Text="Choose a project"
                           Classes="heading"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
                <TextBlock x:Name="DescriptionText"
                           Text="The timer name becomes its project. Time is recorded while this timer is running."
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,18"/>

                <TextBlock Text="PROJECT"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,6"/>

                <Grid ColumnDefinitions="*,Auto">
                    <ComboBox x:Name="ProjectSelector"
                              MinHeight="40"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="ProjectSelector_SelectionChanged"/>
                    <Button x:Name="AddProjectButton"
                            Grid.Column="1"
                            Content="+"
                            Width="40" Height="40"
                            Padding="0"
                            Margin="8,0,0,0"
                            FontSize="18"
                            Classes="modern"
                            ToolTip.Tip="Add new project"
                            Click="AddProjectButton_Click"/>
                </Grid>

                <Border x:Name="NewProjectPanel"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,12,0,0"
                        IsVisible="False">
                    <StackPanel Spacing="6">
                        <TextBlock Text="New project name"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBox x:Name="NewProjectBox"
                                 MaxLength="60"
                                 MinHeight="38"
                                 VerticalContentAlignment="Center"
                                 KeyDown="NewProjectBox_KeyDown"/>
                        <TextBlock x:Name="ValidationText"
                                   Text="Enter a project name."
                                   Foreground="{DynamicResource DangerTextBrush}"
                                   FontSize="11.5"
                                   IsVisible="False"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="CATEGORY"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,14,0,6"/>

                <Grid ColumnDefinitions="*,Auto">
                    <ComboBox x:Name="CategorySelector"
                              MinHeight="40"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="CategorySelector_SelectionChanged"/>
                    <Button x:Name="AddCategoryButton"
                            Grid.Column="1"
                            Content="+"
                            Width="40" Height="40"
                            Padding="0"
                            Margin="8,0,0,0"
                            FontSize="18"
                            Classes="modern"
                            ToolTip.Tip="Add custom category"
                            Click="AddCategoryButton_Click"/>
                </Grid>

                <Border x:Name="NewCategoryPanel"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,12,0,0"
                        IsVisible="False">
                    <StackPanel Spacing="6">
                        <TextBlock Text="New category name (e.g. Work, Learning, Health, Hobbies)"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBox x:Name="NewCategoryBox"
                                 MaxLength="40"
                                 MinHeight="38"
                                 VerticalContentAlignment="Center"
                                 KeyDown="NewCategoryBox_KeyDown"/>
                        <TextBlock x:Name="CategoryValidationText"
                                   Text="Enter a category name."
                                   Foreground="{DynamicResource DangerTextBrush}"
                                   FontSize="11.5"
                                   IsVisible="False"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="NoProjectHintText"
                           Text="Choose ‘No project’ to keep this timer out of reports."
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="2,12,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" Spacing="8">
                    <Button Content="Cancel"
                            Classes="modern"
                            MinWidth="86"
                            Click="Cancel_Click"/>
                    <Button x:Name="SaveButton"
                            Content="Use project"
                            Classes="primary"
                            MinWidth="112"
                            Click="Save_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
