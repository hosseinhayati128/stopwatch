<Window x:Class="StopwatchOverlay.ActiveClocksShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Active Clocks"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Overlay/OverlayStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ShelfRowStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="{DynamicResource ThemeOverlayButtonCornerRadius}"/>
                <Setter Property="Padding" Value="7,4"/>
                <Setter Property="Margin" Value="0,1.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource OverlayHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ShelfPauseButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource OverlayPauseBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OverlayPauseBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource OverlayPauseForegroundBrush}"/>
                <Setter Property="Padding" Value="7,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ThemeOverlayButtonCornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource OverlayHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource OverlayPauseHoverForegroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource OverlayPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="6">
        <Border Background="{DynamicResource OverlayChromeBrush}"
                BorderBrush="{DynamicResource OverlayChromeBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ThemeOverlayCornerRadius}"
                Effect="{DynamicResource OverlayShadowEffect}"
                Padding="12,8"
                MinWidth="230"
                MaxWidth="380">
            <StackPanel>
                <!-- Header bar -->
                <Grid Margin="2,0,2,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource RecBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Running Clocks"
                                   Foreground="{DynamicResource OverlayProjectForegroundBrush}"
                                   FontSize="10.5"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   FontWeight="{DynamicResource OverlayProjectFontWeight}"
                                   Opacity="{DynamicResource OverlayProjectOpacity}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource OverlayActionForegroundBrush}"
                            Opacity="0.75"
                            FontSize="11" Cursor="Hand"
                            Click="CloseButton_Click" ToolTip="Hide running clocks shelf"/>
                </Grid>

                <!-- Clocks List -->
                <StackPanel x:Name="ActiveClocksPanel"/>
            </StackPanel>
        </Border>

        <!-- Inner decorative hairline border for Acanthus & themed clock styles -->
        <Border BorderBrush="{DynamicResource OverlayInnerRuleBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ThemeOverlayCornerRadius}"
                Visibility="{DynamicResource OverlayInnerRuleVisibility}"
                IsHitTestVisible="False"/>
    </Grid>
</Window>
