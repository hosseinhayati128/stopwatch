<Window x:Class="StopwatchOverlay.ActiveClocksShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Active Clocks"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="Height">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Overlay/OverlayStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ShelfRowStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="{DynamicResource ThemeOverlayButtonCornerRadius}"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource OverlayHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ShelfPauseButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource OverlayPauseBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OverlayPauseBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource OverlayPauseForegroundBrush}"/>
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ThemeOverlayButtonCornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource OverlayHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource OverlayPauseHoverForegroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource OverlayPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="ShelfSurface" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <!-- Layer 1: Background surface with opacity & drop shadow matching clock overlay -->
        <Border x:Name="ShelfBackgroundSurface"
                Background="{DynamicResource OverlayChromeBrush}"
                CornerRadius="{DynamicResource ThemeOverlayCornerRadius}"
                Effect="{DynamicResource OverlayShadowEffect}"
                IsHitTestVisible="False"/>

        <!-- Layer 2: Outer frame border matching clock overlay -->
        <Border x:Name="ShelfBorder"
                Background="Transparent"
                BorderBrush="{DynamicResource OverlayChromeBorderBrush}"
                BorderThickness="{DynamicResource ThemeOverlayFrameBorderThickness}"
                CornerRadius="{DynamicResource ThemeOverlayCornerRadius}"
                Padding="8,5">
            <StackPanel>
                <!-- Compact sub-header -->
                <Grid Margin="2,0,2,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource RecBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ShelfHeaderTitle"
                                   Text="RUNNING CLOCKS"
                                   FontSize="8.5"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource OverlayProjectForegroundBrush}"
                                   Opacity="0.55"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource OverlayActionForegroundBrush}"
                            Opacity="0.6"
                            Width="16" Height="16"
                            FontSize="10" Cursor="Hand"
                            Click="CloseButton_Click" ToolTip="Hide running clocks shelf (Win+F2, H)"/>
                </Grid>

                <Border Height="0.5" Background="{DynamicResource OverlayChromeBorderBrush}" Opacity="0.25" Margin="0,0,0,3"/>

                <!-- Clocks List -->
                <StackPanel x:Name="ActiveClocksPanel"/>
            </StackPanel>
        </Border>

        <!-- Layer 3: Inner decorative rule in Acanthus themes -->
        <Border x:Name="ShelfInnerRule"
                BorderBrush="{DynamicResource OverlayInnerRuleBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ThemeOverlayCornerRadius}"
                Visibility="{DynamicResource OverlayInnerRuleVisibility}"
                Margin="4"
                IsHitTestVisible="False"/>
    </Grid>
</Window>
