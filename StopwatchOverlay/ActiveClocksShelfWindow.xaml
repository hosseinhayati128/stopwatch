<Window x:Class="StopwatchOverlay.ActiveClocksShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:StopwatchOverlay.Themes"
        Title="Active Clocks"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        MouseRightButtonDown="Window_MouseRightButtonDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Overlay/OverlayStyles.xaml"/>
                <ResourceDictionary Source="Themes/PirateAssets.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ShelfRowStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="CornerRadius" Value="{DynamicResource ThemeOverlayButtonCornerRadius}"/>
                <Setter Property="Padding" Value="4,3"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource OverlayHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ShelfPauseButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource OverlayPauseBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OverlayPauseBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource OverlayPauseForegroundBrush}"/>
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ThemeOverlayButtonCornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource OverlayHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource OverlayPauseHoverForegroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource OverlayPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="ShelfSurface" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <theme:NoteArtworkBorder x:Name="PirateFrame" Artwork="Frame" IsHitTestVisible="False" Visibility="Collapsed"/>
        <!-- Layer 1: Background surface with opacity & drop shadow matching clock overlay -->
        <Border x:Name="ShelfBackgroundSurface"
                Background="{DynamicResource OverlayChromeBrush}"
                CornerRadius="{DynamicResource ThemeOverlayCornerRadius}"
                Effect="{DynamicResource OverlayShadowEffect}"
                IsHitTestVisible="False"/>

        <!-- Layer 2: Outer frame border matching clock overlay -->
        <Border x:Name="ShelfBorder"
                Background="Transparent"
                BorderBrush="{DynamicResource OverlayChromeBorderBrush}"
                BorderThickness="{DynamicResource ThemeOverlayFrameBorderThickness}"
                CornerRadius="{DynamicResource ThemeOverlayCornerRadius}"
                Padding="6,4">
            <!-- Clocks List (two lines per clock, overlay styled) -->
            <StackPanel>
                <Grid x:Name="PirateHeader" Visibility="Collapsed" Margin="6,4,26,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Rectangle Width="23" Height="23" Fill="{StaticResource PirateSkull}"/>
                    <TextBlock Grid.Column="1" Text="Active Clocks" FontFamily="{StaticResource PirateHeadingFont}"
                               FontSize="20" Foreground="#F2D59C" Margin="6,0,0,0" TextWrapping="Wrap"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="440">
                    <StackPanel x:Name="ActiveClocksPanel"/>
                </ScrollViewer>
                <TextBlock x:Name="PirateFooter" Visibility="Collapsed" Text="Select a clock to take the helm" FontFamily="{StaticResource PirateBodyFont}"
                           FontSize="12" Foreground="#D9BC87" TextAlignment="Center" TextWrapping="Wrap" Margin="4,8,4,4"/>
            </StackPanel>
        </Border>

        <!-- Layer 3: Inner decorative rule in Acanthus themes -->
        <Border x:Name="ShelfInnerRule"
                BorderBrush="{DynamicResource OverlayInnerRuleBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ThemeOverlayCornerRadius}"
                Visibility="{DynamicResource OverlayInnerRuleVisibility}"
                Margin="4"
                IsHitTestVisible="False"/>

        <!-- Discreet floating close button in top-right corner -->
        <Button x:Name="ShelfCloseButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,3,4,0"
                Content="✕"
                Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource OverlayActionForegroundBrush}"
                Opacity="0.35"
                Width="14" Height="14"
                FontSize="8.5" Cursor="Hand"
                Click="CloseButton_Click" ToolTip="Hide running clocks shelf (Win+F2, H, Esc, or Right-Click)"/>
    </Grid>
</Window>
