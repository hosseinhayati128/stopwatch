<Window x:Class="StopwatchOverlay.TimerNameWindow" Style="{StaticResource {x:Type Window}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose project"
        Width="520" SizeToContent="Height" MaxHeight="780"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/PirateDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer Style="{StaticResource PirateDialogScroll}">
    <Border MinWidth="360" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}" LayoutTransform="{DynamicResource ApplicationScaleTransform}" Style="{StaticResource PirateDialogSurface}" Margin="18">
    <StackPanel Margin="24">
        <Rectangle Style="{StaticResource PirateDialogSkull}"/>
        <Image Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8"
              Source="{StaticResource AcanthusCrestImage}"
              Stretch="Uniform" Visibility="{DynamicResource OrnamentVisibility}"/>
        <TextBlock x:Name="HeadingText" Text="Choose a project" Style="{StaticResource DisplayHeadingText}"
                   HorizontalAlignment="Center"/>
        <TextBlock x:Name="DescriptionText"
                   Text="The timer name becomes its project. Time is recorded while this timer is running."
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" Margin="0,5,0,18"/>

        <TextBlock Text="Project" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,7"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ProjectSelector"
                      MinHeight="44"
                      AutomationProperties.Name="Project"
                      SelectionChanged="ProjectSelector_SelectionChanged"
                      DropDownClosed="ProjectSelector_DropDownClosed"
                      KeyDown="ProjectSelector_KeyDown"/>
            <Button x:Name="AddProjectButton"
                    Grid.Column="1"
                    Content="+"
                    Width="44"
                    Height="44"
                    Padding="0"
                    Margin="8,0,0,0"
                    FontSize="20"
                    Style="{StaticResource ModernButton}"
                    ToolTip="Add new project"
                    AutomationProperties.Name="Add new project"
                    AutomationProperties.HelpText="Open a field for entering a new project name"
                    Click="AddProjectButton_Click"/>
        </Grid>

        <Border x:Name="NewProjectPanel"
                Style="{StaticResource SettingsCard}"
                Margin="0,12,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="New project name"
                           Style="{StaticResource SectionHeaderText}"
                           Margin="0,0,0,7"/>
                <TextBox x:Name="NewProjectBox"
                         MaxLength="60"
                         MinHeight="42"
                         AutomationProperties.Name="New project name"
                         Style="{StaticResource TimeInputBox}"
                         VerticalContentAlignment="Center"
                         KeyDown="NewProjectBox_KeyDown"/>
                <TextBlock x:Name="ValidationText"
                           Text="Enter a project name."
                           Foreground="{DynamicResource DangerTextBrush}"
                           AutomationProperties.LiveSetting="Assertive"
                           Margin="2,7,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Category & Score / Hour Row -->
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Category -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Category" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,7"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CategorySelector"
                              MinHeight="44"
                              AutomationProperties.Name="Category"
                              SelectionChanged="CategorySelector_SelectionChanged"
                              DropDownClosed="CategorySelector_DropDownClosed"/>
                    <Button x:Name="AddCategoryButton"
                            Grid.Column="1"
                            Content="+"
                            Width="44"
                            Height="44"
                            Padding="0"
                            Margin="8,0,0,0"
                            FontSize="20"
                            Style="{StaticResource ModernButton}"
                            ToolTip="Add custom category"
                            AutomationProperties.Name="Add custom category"
                            AutomationProperties.HelpText="Open a field for entering a custom category name"
                            Click="AddCategoryButton_Click"/>
                </Grid>
            </StackPanel>

            <!-- Score per hour -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Score / hour" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,7"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ScorePerHourBox"
                             Text="1.0"
                             MinHeight="44"
                             TextAlignment="Center"
                             Padding="0,0,0,2"
                             AutomationProperties.Name="Score per hour"
                             Style="{StaticResource TimeInputBox}"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             KeyDown="ScorePerHourBox_KeyDown"/>
                    <TextBlock Grid.Column="1" Text="pts/hr"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12" Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>
        </Grid>

        <Border x:Name="NewCategoryPanel"
                Style="{StaticResource SettingsCard}"
                Margin="0,10,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="New category name (e.g. Work, Learning, Health, Hobbies)"
                           Style="{StaticResource SectionHeaderText}"
                           Margin="0,0,0,7"/>
                <TextBox x:Name="NewCategoryBox"
                         MaxLength="40"
                         MinHeight="42"
                         AutomationProperties.Name="New category name"
                         Style="{StaticResource TimeInputBox}"
                         VerticalContentAlignment="Center"
                         KeyDown="NewCategoryBox_KeyDown"/>
                <TextBlock x:Name="CategoryValidationText"
                           Text="Enter a category name."
                           Foreground="{DynamicResource DangerTextBrush}"
                           AutomationProperties.LiveSetting="Assertive"
                           Margin="2,7,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="NoProjectHintText"
                   Text="Choose 'No project' to keep this timer out of reports."
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" Margin="2,12,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource ModernButton}"
                    MinWidth="86" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="Use project" Click="Save_Click" Style="{StaticResource StartButton}"
                    IsDefault="True"
                    MinWidth="112"/>
        </StackPanel>
    </StackPanel>
    </Border>
    </ScrollViewer>
</Window>
