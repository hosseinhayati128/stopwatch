<Window x:Class="StopwatchOverlay.BackgroundTimerReminderPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:StopwatchOverlay.Themes"
        Title="Background Timer Alert"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Overlay/OverlayStyles.xaml"/>
                <ResourceDictionary Source="Themes/PirateAssets.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="OverlayPopupButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource OverlayActionBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OverlayToolbarBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource OverlayActionForegroundBrush}"/>
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="11,5"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ThemeOverlayButtonCornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource OverlayHoverBrush}"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource OverlayActionForegroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource OverlayPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="theme:PirateVisual.Enabled" Value="True">
                        <Setter Property="Template" Value="{StaticResource PirateBrassButtonTemplate}"/>
                        <Setter Property="FontFamily" Value="{StaticResource PirateBodyFont}"/>
                        <Setter Property="FontSize" Value="17"/><Setter Property="MinHeight" Value="46"/>
                        <Setter Property="Foreground" Value="#382519"/><Setter Property="Padding" Value="8,6"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PrimaryKeepRunningButtonStyle" TargetType="Button" BasedOn="{StaticResource OverlayPopupButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <Style x:Key="StopActionButtonStyle" TargetType="Button" BasedOn="{StaticResource OverlayPopupButtonStyle}">
                <Setter Property="BorderBrush" Value="{DynamicResource RecBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource RecBrush}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="6">
        <theme:NoteArtworkBorder x:Name="PirateFrame" Artwork="Frame" Visibility="Collapsed" IsHitTestVisible="False"/>
        <!-- Layer 1: Background surface matching clock overlay with opacity, pattern & shadow -->
        <Border x:Name="ReminderBackgroundSurface"
                Background="{DynamicResource OverlayChromeBrush}"
                CornerRadius="{DynamicResource ThemeOverlayCornerRadius}"
                Effect="{DynamicResource OverlayShadowEffect}"
                IsHitTestVisible="False"/>

        <!-- Layer 2: Main border container matching floating clock overlay frame -->
        <Border x:Name="ReminderBorder"
                Background="Transparent"
                BorderBrush="{DynamicResource OverlayChromeBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ThemeOverlayCornerRadius}"
                Padding="14,10"
                MinWidth="310"
                MaxWidth="400">
            <StackPanel>
                <!-- Header bar -->
                <StackPanel Margin="0,0,0,8">
                        <TextBlock x:Name="ReminderHeading" Text="Clock running in background" TextWrapping="Wrap"
                                   Foreground="{DynamicResource OverlayProjectForegroundBrush}"
                                   FontSize="11"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   FontWeight="{DynamicResource OverlayProjectFontWeight}"
                                   Opacity="{DynamicResource OverlayProjectOpacity}"/>

                    <!-- Reminder badge: e.g. "Reminder 1 of 3" -->
                    <Border x:Name="ReminderBadgeBorder" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Background="{DynamicResource OverlayToolbarSurfaceBrush}"
                            BorderBrush="{DynamicResource OverlayToolbarBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ThemeOverlayButtonCornerRadius}"
                            Padding="6,2">
                        <TextBlock x:Name="ReminderBadgeText"
                                   Text="Reminder 1 of 3" TextWrapping="Wrap"
                                   Foreground="{DynamicResource OverlayActionForegroundBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Timer info -->
                <Grid Margin="0,2,0,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <theme:NoteArtworkBorder x:Name="PiratePaper" Artwork="Paper" Grid.ColumnSpan="2" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <StackPanel x:Name="TimerDetails" VerticalAlignment="Center">
                        <TextBlock x:Name="TimerNameText"
                                   Text="Timer 1"
                                   Foreground="{DynamicResource OverlayProjectForegroundBrush}"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   FontSize="{DynamicResource OverlayProjectFontSize}"
                                   FontWeight="{DynamicResource OverlayProjectFontWeight}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TimeoutCountdownText"
                                   Text="Closes in 30s"
                                   Foreground="{DynamicResource OverlayProjectForegroundBrush}"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   Opacity="0.65"
                                   FontSize="10"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Live elapsed time -->
                    <TextBlock Grid.Column="1" x:Name="TimerElapsedText"
                               Text="00:00:00"
                               FontFamily="{DynamicResource ThemeTimerFontFamily}"
                               Foreground="{DynamicResource OverlayTimerForegroundBrush}"
                               FontSize="18"
                               FontWeight="{DynamicResource OverlayTimerFontWeight}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Action buttons -->
                <UniformGrid Columns="3" Margin="0,4,0,0">
                    <Button x:Name="KeepRunningButton"
                            Content="✓ Keep Running"
                            Style="{StaticResource PrimaryKeepRunningButtonStyle}"
                            ToolTip="Acknowledge and keep this clock running in background"
                            Click="KeepRunningButton_Click"/>

                    <Button x:Name="SwitchButton"
                            Content="➜ Switch"
                            Style="{StaticResource OverlayPopupButtonStyle}"
                            ToolTip="Switch active overlay to this clock"
                            Click="SwitchButton_Click"/>

                    <Button x:Name="StopButton"
                            Content="⏹ Stop"
                            Style="{StaticResource StopActionButtonStyle}"
                            Margin="0,0,0,0"
                            ToolTip="Stop this clock now"
                            Click="StopButton_Click"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Inner hairline decorative rule for Acanthus & themed clock styles -->
        <Border x:Name="ReminderInnerRule"
                BorderBrush="{DynamicResource OverlayInnerRuleBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ThemeOverlayCornerRadius}"
                Visibility="{DynamicResource OverlayInnerRuleVisibility}"
                Margin="4"
                IsHitTestVisible="False"/>
    </Grid>
</Window>
