<Window x:Class="StopwatchOverlay.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard Shortcuts"
        Width="520" Height="620" MinWidth="460" MinHeight="480"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border Style="{StaticResource DialogSurface}" Margin="16">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <Path Width="24" Height="24" HorizontalAlignment="Center" Margin="0,0,0,6"
                  Data="{StaticResource AcanthusCrestGeometry}" Fill="{DynamicResource OrnamentAccentBrush}"
                  Stretch="Uniform" Visibility="{DynamicResource OrnamentVisibility}"/>
            <TextBlock Text="Keyboard shortcuts" Style="{StaticResource DisplayHeadingText}"
                       FontSize="23" HorizontalAlignment="Center"/>
            <TextBlock Text="Click a shortcut box and press a key combination. Pressing the leader enters a 2-second command mode where the next key triggers an action."
                       TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>

        <!-- Leader shortcut row -->
        <Grid Grid.Row="1" Margin="0,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Leader shortcut:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBox Grid.Column="1" x:Name="LeaderShortcutBox" Tag="CommandLeader" IsReadOnly="True" Margin="0,0,8,0"
                     GotFocus="ShortcutBox_GotFocus" LostFocus="ShortcutBox_LostFocus" PreviewKeyDown="ShortcutBox_PreviewKeyDown"/>
            <Button Grid.Column="2" Content="Clear" Tag="CommandLeader" Click="ClearShortcut_Click" Style="{StaticResource ModernButton}"/>
        </Grid>

        <!-- Show active overlay shortcut row -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Show active overlay:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBox Grid.Column="1" x:Name="ShowActiveOverlayShortcutBox" Tag="ShowActiveOverlay" IsReadOnly="True" Margin="0,0,8,0"
                     GotFocus="ShortcutBox_GotFocus" LostFocus="ShortcutBox_LostFocus" PreviewKeyDown="ShortcutBox_PreviewKeyDown"/>
            <Button Grid.Column="2" Content="Clear" Tag="ShowActiveOverlay" Click="ClearShortcut_Click" Style="{StaticResource ModernButton}"/>
        </Grid>

        <!-- Open controller shortcut row -->
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Open controller:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBox Grid.Column="1" x:Name="OpenControllerShortcutBox" Tag="OpenController" IsReadOnly="True" Margin="0,0,8,0"
                     GotFocus="ShortcutBox_GotFocus" LostFocus="ShortcutBox_LostFocus" PreviewKeyDown="ShortcutBox_PreviewKeyDown"/>
            <Button Grid.Column="2" Content="Clear" Tag="OpenController" Click="ClearShortcut_Click" Style="{StaticResource ModernButton}"/>
        </Grid>

        <!-- Read-only command mode mapping -->
        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource ThemeCardCornerRadius}" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Command mode keys (fixed):" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Space" FontWeight="Bold" Margin="0,3,8,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Start or stop the active timer" Margin="0,3,0,3"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="R" FontWeight="Bold" Margin="0,3,8,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Reset the active timer" Margin="0,3,0,3"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="O" FontWeight="Bold" Margin="0,3,8,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Show or hide the active timer overlay" Margin="0,3,0,3"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="L" FontWeight="Bold" Margin="0,3,8,3"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Record a lap" Margin="0,3,0,3"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="C" FontWeight="Bold" Margin="0,3,8,3"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Toggle between current mode and Clock" Margin="0,3,0,3"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="N" FontWeight="Bold" Margin="0,3,8,3"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Create a new timer and make it active" Margin="0,3,0,3"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="T" FontWeight="Bold" Margin="0,3,8,3"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="Select the next active timer" Margin="0,3,0,3"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="X" FontWeight="Bold" Margin="0,3,8,3"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="Close the active timer" Margin="0,3,0,3"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="P" FontWeight="Bold" Margin="0,3,8,3"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="Select, create, change, or clear project" Margin="0,3,0,3"/>

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="D" FontWeight="Bold" Margin="0,3,8,3"/>
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="Open project time dashboard" Margin="0,3,0,3"/>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="W" FontWeight="Bold" Margin="0,3,8,3"/>
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="Open stopwatch controller" Margin="0,3,0,3"/>

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Escape" FontWeight="Bold" Margin="0,3,8,3"/>
                        <TextBlock Grid.Row="11" Grid.Column="1" Text="Cancel command mode without action" Margin="0,3,0,3"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Reset to defaults" Click="ResetDefaults_Click" Style="{StaticResource ModernButton}" Margin="0,0,8,0"/>
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource ModernButton}" Margin="0,0,8,0" MinWidth="80"/>
            <Button Content="Save" Click="Save_Click" Style="{StaticResource StartButton}" MinWidth="80"/>
        </StackPanel>
    </Grid>
    </Border>
</Window>
