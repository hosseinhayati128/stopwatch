<Window x:Class="StopwatchOverlay.ControllerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:StopwatchOverlay.Themes"
        p:PirateVisual.Enabled="{DynamicResource PirateControllerEnabled}"
        Title="Stopwatch Controller" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="Manual"
        MinWidth="560" MinHeight="520"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/PirateControllerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style>
        <Style TargetType="Window" BasedOn="{StaticResource {x:Type Window}}">
            <Setter Property="Width" Value="1040"/><Setter Property="Height" Value="720"/>
            <Style.Triggers><Trigger Property="p:PirateVisual.Enabled" Value="True">
                <Setter Property="Width" Value="1200"/><Setter Property="Height" Value="920"/>
            </Trigger></Style.Triggers>
        </Style>
    </Window.Style>
    <Grid Style="{StaticResource ControllerFrame}" LayoutTransform="{DynamicResource ApplicationScaleTransform}">
    <DockPanel Style="{StaticResource ControllerDock}">
    <Border DockPanel.Dock="Top" Style="{StaticResource ControllerHeader}">
        <p:ControllerHeaderPanel Margin="18,0">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,0,18,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Rectangle Width="38" Height="38" Margin="0,0,9,0" Fill="{StaticResource PirateSkull}" Style="{StaticResource PirateOnly}"/>
                <Image Width="28" Height="28" Margin="0,0,10,0"
                      Source="{StaticResource AcanthusCrestImage}"
                      Stretch="Uniform"
                      Visibility="{DynamicResource OrnamentVisibility}"/>
                <Image Source="pack://application:,,,/StopwatchOverlay;component/project-logo-24.png" Width="24" Height="24"
                       Margin="0,0,10,0" VerticalAlignment="Center"
                       Style="{StaticResource ControllerBrandIcon}"/>
                <TextBlock Style="{StaticResource ControllerHeaderTitle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            </Viewbox>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Records &amp; Analytics" Margin="0,0,8,0"
                        Style="{StaticResource ControllerTopButton}"
                        Click="ProjectDashboardMenuItem_Click"/>
                <Button Content="Settings" Margin="0,0,8,0"
                        Style="{StaticResource ControllerTopButton}"
                        Click="OpenSettings_Click"/>
                <Button Content="Shortcuts"
                        Style="{StaticResource ControllerTopButton}"
                        Click="OpenShortcuts_Click"/>
            </StackPanel>
            </Viewbox>
        </p:ControllerHeaderPanel>
    </Border>
    <Menu DockPanel.Dock="Top" Style="{StaticResource ControllerMenu}" ItemContainerStyle="{StaticResource ControllerMenuItem}">
        <MenuItem Header="_Timers" Style="{StaticResource ControllerMenuItem}">
            <MenuItem x:Name="NewTimerMenuItem" Header="_New timer" Click="NewTimerMenuItem_Click"/>
            <MenuItem x:Name="NextTimerMenuItem" Header="_Next active timer" Click="NextTimerMenuItem_Click"/>
            <MenuItem x:Name="ToggleCombinedOverlayMenuItem" Header="_Combine overlays" Click="ToggleCombinedOverlayMenuItem_Click"/>
            <Separator/>
            <MenuItem x:Name="EditTimerMenuItem" Header="_Edit active timer..." Click="EditTimerMenuItem_Click"/>
            <MenuItem x:Name="UndoTimerEditMenuItem" Header="_Undo last timer edit" InputGestureText="Ctrl+Z" Click="UndoTimerEditMenuItem_Click" IsEnabled="False"/>
            <MenuItem x:Name="RenameTimerMenuItem" Header="Set _project" Click="RenameTimerMenuItem_Click"/>
            <MenuItem x:Name="CloseTimerMenuItem" Header="_Close active timer" Click="CloseTimerMenuItem_Click"/>
        </MenuItem>
        <MenuItem x:Name="ProjectDashboardMenuItem"
                  Style="{StaticResource ControllerMenuItem}"
                  Header="Project _dashboard"
                  Click="ProjectDashboardMenuItem_Click"/>
        <MenuItem Header="_Shortcuts" Click="OpenShortcuts_Click" Style="{StaticResource ControllerMenuItem}"/>
        <MenuItem x:Name="SmartInputMenuItem" Header="Switch to smart _input"
                  Style="{StaticResource ControllerMenuItem}"
                  Click="SmartInputMenuItem_Click"/>
    </Menu>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TimerRailColumn" Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="TimerRail" Grid.Column="0" Style="{StaticResource ControllerRail}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Timers" Style="{StaticResource ControllerRailHeading}"/>
                <ListBox x:Name="TimerRailList" Grid.Row="1"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource ControllerRailItem}"
                         SelectionChanged="TimerRailList_SelectionChanged"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ControllerRailCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ControllerRailName}"/>
                                    <TextBlock Text="{Binding DisplaySummary}" Style="{StaticResource ControllerRailSummary}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="CombinedRailStatus" Text="Separate overlays"
                               Style="{StaticResource ControllerRailStatus}"/>
                    <Button x:Name="RailNewTimerButton"
                            Content="+ New timer" Style="{StaticResource ControllerRailNew}"
                            AutomationProperties.Name="Create a new timer"
                            Click="NewTimerMenuItem_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource ControllerMap}"/>
    <ScrollViewer x:Name="ControllerScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  CanContentScroll="False"
                  PanningMode="VerticalFirst">
    <Grid Style="{StaticResource ControllerWorkspace}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title and the primary timer-session action -->
        <Grid Grid.Row="0" Margin="0,6,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Fill="{StaticResource PirateLogPose}" Width="56" Height="56" HorizontalAlignment="Left" Margin="0,-4,0,-4"
                       Style="{StaticResource PirateOnly}" IsHitTestVisible="False"/>
            <Grid Grid.Column="0" Grid.ColumnSpan="3" Margin="132,0,166,0">
                <TextBlock x:Name="ActiveWorkspaceTitle" Text="Active timer"
                           Style="{StaticResource ControllerWorkspaceTitle}"
                           VerticalAlignment="Center"/>
            </Grid>
            <Button x:Name="NewTimerButton"
                    Grid.Column="2"
                    Content="+ New timer"
                    Style="{StaticResource ControllerTopButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Create a new timer"
                    AutomationProperties.HelpText="Choose a project, then create the timer"
                    Click="NewTimerMenuItem_Click"/>
        </Grid>

        <!-- Mode Selection -->
        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,14">
            <RadioButton x:Name="StopwatchModeRadio" Content="Stopwatch"
                         IsChecked="True" GroupName="Mode"
                         Checked="ModeRadio_Checked" Style="{StaticResource ControllerMode}"/>
            <RadioButton x:Name="ClockModeRadio" Content="Clock"
                         GroupName="Mode"
                         Checked="ModeRadio_Checked" Style="{StaticResource ControllerMode}"/>
            <RadioButton x:Name="CountdownModeRadio" Content="Countdown"
                         GroupName="Mode"
                         Checked="ModeRadio_Checked" Style="{StaticResource ControllerMode}"/>
            <RadioButton x:Name="TimecodeModeRadio" Content="Timecode"
                         GroupName="Mode"
                         Checked="ModeRadio_Checked" Style="{StaticResource ControllerMode}" Margin="0"/>
        </WrapPanel>

        <!-- Countdown inputs (only visible in countdown mode) -->
        <StackPanel x:Name="CountdownPanel" Grid.Row="2" Orientation="Vertical"
                    HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed">

            <!-- Classic spinner UI -->
            <StackPanel x:Name="CountdownClassicPanel" Orientation="Vertical" HorizontalAlignment="Center">
                <!-- Duration vs. Until-clock-time toggle -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <RadioButton x:Name="CountdownDurationRadio" Style="{StaticResource ControllerEditorRadio}" Content="Duration" IsChecked="True"
                                 GroupName="CountdownType" Checked="CountdownTypeRadio_Checked" Margin="0,0,12,0"/>
                    <RadioButton x:Name="CountdownUntilRadio" Style="{StaticResource ControllerEditorRadio}" Content="Until clock time"
                                 GroupName="CountdownType" Checked="CountdownTypeRadio_Checked"/>
                </StackPanel>

                <!-- Fixed-duration inputs -->
                <StackPanel x:Name="CountdownDurationPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Duration: " Style="{StaticResource ControllerEditorLabel}" VerticalAlignment="Center"/>
                    <TextBox x:Name="CountdownMinutes" Width="40" Text="5" Style="{StaticResource ControllerTimeInput}"
                             TextAlignment="Center" VerticalContentAlignment="Center"
                             TextChanged="TimerEditor_TextChanged"/>
                    <TextBlock Text=" min " Style="{StaticResource ControllerEditorLabel}" VerticalAlignment="Center"/>
                    <TextBox x:Name="CountdownSeconds" Width="40" Text="00" Style="{StaticResource ControllerTimeInput}"
                             TextAlignment="Center" VerticalContentAlignment="Center"
                             TextChanged="TimerEditor_TextChanged"/>
                    <TextBlock Text=" sec" Style="{StaticResource ControllerEditorLabel}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Until-clock-time inputs -->
                <StackPanel x:Name="CountdownUntilPanel" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Until: " Style="{StaticResource ControllerEditorLabel}" VerticalAlignment="Center"/>
                    <TextBox x:Name="ClockTargetHours" Width="40" Text="00" Style="{StaticResource ControllerTimeInput}"
                             TextAlignment="Center" VerticalContentAlignment="Center"
                             TextChanged="TimerEditor_TextChanged"/>
                    <TextBlock Text=" : " Style="{StaticResource ControllerEditorLabel}" VerticalAlignment="Center"/>
                    <TextBox x:Name="ClockTargetMinutes" Width="40" Text="00" Style="{StaticResource ControllerTimeInput}"
                             TextAlignment="Center" VerticalContentAlignment="Center"
                             TextChanged="TimerEditor_TextChanged"/>
                    <TextBlock Text=" : " Style="{StaticResource ControllerEditorLabel}" VerticalAlignment="Center"/>
                    <TextBox x:Name="ClockTargetSeconds" Width="40" Text="00" Style="{StaticResource ControllerTimeInput}"
                             TextAlignment="Center" VerticalContentAlignment="Center"
                             TextChanged="TimerEditor_TextChanged"/>
                </StackPanel>
            </StackPanel>

            <!-- Smart free-text UI -->
            <StackPanel x:Name="CountdownSmartPanel" Orientation="Vertical"
                        HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBox x:Name="SmartInputBox" Width="280" Style="{StaticResource ControllerTimeInput}"
                         VerticalContentAlignment="Center"
                         TextChanged="SmartInputBox_TextChanged"
                         KeyDown="SmartInputBox_KeyDown"/>
                <TextBlock x:Name="SmartPreview" Margin="0,4,0,0" TextAlignment="Center"
                           Style="{StaticResource ControllerEditorLabel}"
                           Text="e.g. 5m, 1h30m, 2 pm, tomorrow 9 am"/>
            </StackPanel>
        </StackPanel>

        <!-- Current Time Display -->
        <Grid Grid.Row="3">
        <Border Style="{StaticResource ControllerHero}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="RecIndicator" Grid.Column="0" Width="16" Height="16" 
                         Fill="{DynamicResource RecBrush}" Margin="0,0,10,0" Visibility="Collapsed"/>
                <TextBlock x:Name="TimeDisplay" Grid.Column="1"
                           Text="00:00:00.0" 
                           Style="{StaticResource ControllerTime}"/>
                <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="{Binding MaximumDisplayHeight, ElementName=PirateTimeDisplay}" Margin="8,0"
                         Style="{StaticResource PirateOnly}">
                    <p:PirateTimerText x:Name="PirateTimeDisplay" Text="{Binding Text, ElementName=TimeDisplay}"/>
                </Viewbox>
            </Grid>
        </Border>
        <Image Source="{StaticResource AcanthusHeroFrameImage}" Stretch="Fill"
               Margin="0,0,0,14" IsHitTestVisible="False"
               Visibility="{DynamicResource OrnamentVisibility}"/>
        </Grid>

        <!-- Control Buttons -->
        <p:ControllerActionPanel Grid.Row="4" Grid.RowSpan="2" Style="{StaticResource ControllerActions}">
            <Button x:Name="StartStopButton" Content="Start  ·  Win+F2 → Space"
                    Style="{StaticResource ControllerStart}"
                    Click="StartStopButton_Click"/>
            <Button x:Name="LapButton" Content="Add lap  ·  Win+F2 → L"
                    Style="{StaticResource ControllerLap}"
                    Click="LapButton_Click"/>
            <Button x:Name="ResetButton" Content="Reset  ·  Win+F2 → R"
                    Style="{StaticResource ControllerReset}"
                    Click="ResetButton_Click"/>
            <Button x:Name="ToggleOverlayButton" Content="Show overlay  ·  Win+F2 → O"
                    Style="{StaticResource ControllerOverlay}"
                    Click="ToggleOverlayButton_Click"/>
        </p:ControllerActionPanel>

        <!-- Options Row -->
        <WrapPanel Grid.Row="6" HorizontalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed">
            <CheckBox x:Name="AutoStartCheckBox" Content="Auto-start on show" 
                      Checked="OptionCheckBox_Changed" Unchecked="OptionCheckBox_Changed"
                      Margin="0,0,20,0"/>
            <CheckBox x:Name="ShowRecIndicatorCheckBox" Content="REC indicator" 
                      Checked="ShowRecIndicatorCheckBox_Changed" 
                      Unchecked="ShowRecIndicatorCheckBox_Changed" Margin="0,0,20,0"/>
            <CheckBox x:Name="ClickThroughCheckBox" Content="Click-through" 
                      Checked="ClickThroughCheckBox_Changed" 
                      Unchecked="ClickThroughCheckBox_Changed" Margin="0,0,20,0"/>
            <CheckBox x:Name="BlinkColonCheckBox" Content="Blink colon" 
                      Checked="OptionCheckBox_Changed" Unchecked="OptionCheckBox_Changed"
                      Margin="0,0,0,0"/>
        </WrapPanel>

        <!-- Settings Expander -->
        <Expander Grid.Row="7" IsExpanded="False" Margin="0,0,0,10" Visibility="Collapsed"
                  VerticalAlignment="Stretch">
            <Expander.Header>
                <TextBlock Text="Settings" FontWeight="SemiBold"/>
            </Expander.Header>
            <StackPanel Margin="2,6,8,4">
                <!-- Theme and tiled application background -->
                <TextBlock Text="Theme &amp; background" Style="{StaticResource SectionHeaderText}" Margin="0,4,0,8"/>
                <Border Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Theme"
                                   VerticalAlignment="Center" Margin="0,0,18,10"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ThemeModeSelector"
                                  SelectionChanged="ThemeModeSelector_SelectionChanged"
                                  Margin="0,0,0,10">
                            <ComboBoxItem Content="Midnight" IsSelected="True"/>
                            <ComboBoxItem Content="Daylight"/>
                            <ComboBoxItem Content="Pixel Deck Night"/>
                            <ComboBoxItem Content="Pixel Deck Day"/>
                            <ComboBoxItem Content="Acanthus"/>
                            <ComboBoxItem Content="one piece"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Pattern"
                                   VerticalAlignment="Center" Margin="0,0,18,10"/>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" x:Name="PanelBackgroundSelector"
                                      DisplayMemberPath="DisplayLabel"
                                      SelectionChanged="PanelBackgroundSelector_SelectionChanged"
                                      AutomationProperties.Name="Application background pattern"
                                      ToolTip="Choose a tiled background pattern"/>
                            <Border Grid.Column="1" x:Name="PanelBackgroundPreview"
                                    Width="44" Height="30" Margin="8,0,2,0"
                                    VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ThemeItemCornerRadius}"
                                    ToolTip="Preview of the selected background"/>
                            <Button Grid.Column="2" x:Name="AddPanelBackgroundButton"
                                    Content="+" Width="40" Height="40" Padding="0"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource ModernButton}"
                                    FontSize="20" FontWeight="Normal"
                                    ToolTip="Add new background"
                                    AutomationProperties.Name="Add new background"
                                    AutomationProperties.HelpText="Copy a JPG, PNG, or BMP image into the background library"
                                    Click="AddPanelBackgroundButton_Click"/>
                            <Button Grid.Column="3" x:Name="RemovePanelBackgroundButton"
                                    Content="−" Width="40" Height="40" Padding="0"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource ModernButton}"
                                    FontSize="20" FontWeight="Normal"
                                    IsEnabled="False"
                                    ToolTip="Remove selected custom background"
                                    AutomationProperties.Name="Remove selected custom background"
                                    AutomationProperties.HelpText="Remove this imported image from the background library"
                                    Click="RemovePanelBackgroundButton_Click"/>
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Pattern strength"
                                   VerticalAlignment="Center" Margin="0,0,18,8"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <Slider x:Name="PanelBackgroundStrengthSlider"
                                    Width="210"
                                    Minimum="10" Maximum="45" Value="30"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="PanelBackgroundStrengthSlider_ValueChanged"
                                    AutomationProperties.Name="Background pattern strength"/>
                            <TextBlock x:Name="PanelBackgroundStrengthLabel" Text="30%"
                                       VerticalAlignment="Center" Margin="8,0,0,0" Width="42"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="Patterns repeat across panels, reports, dialogs, and floating clocks. Custom images are copied into the app so they remain available after restart."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- Screen and Position -->
                <TextBlock Text="Screen &amp; position" Style="{StaticResource SectionHeaderText}" Margin="0,2,0,8"/>
                <Border Style="{StaticResource SettingsCard}">
                <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Display"
                                   VerticalAlignment="Center" Margin="0,0,18,10"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ScreenSelector"
                                  SelectionChanged="ScreenSelector_SelectionChanged"
                                  Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Position"
                                   VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="PositionSelector"
                                  SelectionChanged="PositionSelector_SelectionChanged">
                            <ComboBoxItem Content="Top Left"/>
                            <ComboBoxItem Content="Top Center" IsSelected="True"/>
                            <ComboBoxItem Content="Top Right"/>
                            <ComboBoxItem Content="Bottom Left"/>
                            <ComboBoxItem Content="Bottom Center"/>
                            <ComboBoxItem Content="Bottom Right"/>
                            <ComboBoxItem Content="Custom"/>
                        </ComboBox>
                        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                  x:Name="HideOverlayFromCaptureCheckBox"
                                  Content="Hide floating timer from screen capture"
                                  Margin="0,12,0,0"/>
                </Grid>
                </Border>

                <!-- Appearance -->
                <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderText}" Margin="0,2,0,8"/>
                <Border Style="{StaticResource SettingsCard}">
                <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Text" 
                                   VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="TextColorSelector" 
                                  SelectionChanged="AppearanceChanged" Margin="0,0,18,10">
                            <ComboBoxItem Content="Theme default"/>
                            <ComboBoxItem Content="White" IsSelected="True"/>
                            <ComboBoxItem Content="Charcoal"/>
                            <ComboBoxItem Content="Yellow"/>
                            <ComboBoxItem Content="Cyan"/>
                            <ComboBoxItem Content="Lime"/>
                            <ComboBoxItem Content="Orange"/>
                            <ComboBoxItem Content="Red"/>
                            <ComboBoxItem Content="Magenta"/>
                        </ComboBox>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Outline" 
                                   VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <ComboBox Grid.Row="0" Grid.Column="3" x:Name="BorderColorSelector" 
                                  SelectionChanged="AppearanceChanged" Margin="0,0,0,10">
                            <ComboBoxItem Content="Black" IsSelected="True"/>
                            <ComboBoxItem Content="White"/>
                            <ComboBoxItem Content="Dark Gray"/>
                            <ComboBoxItem Content="Red"/>
                            <ComboBoxItem Content="Blue"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Font" 
                                   VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FontSelector" 
                                  SelectionChanged="AppearanceChanged" Margin="0,0,18,10">
                            <ComboBoxItem Content="Consolas" IsSelected="True"/>
                            <ComboBoxItem Content="Segoe UI"/>
                            <ComboBoxItem Content="Arial"/>
                            <ComboBoxItem Content="Courier New"/>
                            <ComboBoxItem Content="Lucida Console"/>
                            <ComboBoxItem Content="Cascadia Mono"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Format" 
                                   VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <ComboBox Grid.Row="1" Grid.Column="3" x:Name="TimeFormatSelector" 
                                  SelectionChanged="TimeFormatSelector_SelectionChanged" Margin="0,0,0,10">
                            <ComboBoxItem Content="HH:MM:SS.t" IsSelected="True"/>
                            <ComboBoxItem Content="HH:MM:SS"/>
                            <ComboBoxItem Content="MM:SS.t"/>
                            <ComboBoxItem Content="MM:SS"/>
                            <ComboBoxItem Content="HH:MM"/>
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Size" 
                                   VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,18,10">
                            <Slider x:Name="TextSizeSlider" Width="100" Minimum="16" Maximum="120" Value="48"
                                    VerticalAlignment="Center" ValueChanged="AppearanceSliderChanged"/>
                            <TextBlock x:Name="TextSizeLabel" Text="48" 
                                       VerticalAlignment="Center" Margin="5,0,0,0" Width="25"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Thickness" 
                                   VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,10">
                            <Slider x:Name="BorderWidthSlider" Width="100" Minimum="1" Maximum="5" Value="2"
                                    VerticalAlignment="Center" ValueChanged="AppearanceSliderChanged"/>
                            <TextBlock x:Name="BorderWidthLabel" Text="2" 
                                       VerticalAlignment="Center" Margin="5,0,0,0" Width="25"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Clock opacity"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                            <Slider x:Name="BackgroundOpacitySlider" Width="200" Minimum="0" Maximum="100" Value="50"
                                    VerticalAlignment="Center" ValueChanged="AppearanceSliderChanged"/>
                            <TextBlock x:Name="BackgroundOpacityLabel" Text="50%" 
                                       VerticalAlignment="Center" Margin="5,0,0,0" Width="35"/>
                        </StackPanel>
                </Grid>
                </Border>

                <!-- Light Ring -->
                <TextBlock Text="Light ring" Style="{StaticResource SectionHeaderText}" Margin="0,2,0,8"/>
                <Border Style="{StaticResource SettingsCard}" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.Column="0" x:Name="LightRingCheckBox" 
                              Content="Enable" VerticalAlignment="Center" Margin="0,0,15,5"
                              Checked="LightRingCheckBox_Changed" Unchecked="LightRingCheckBox_Changed"/>
                    
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Brightness:" 
                               VerticalAlignment="Center" Margin="0,0,5,5"/>
                    <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,5">
                        <Slider x:Name="LightRingBrightnessSlider" Width="120" Minimum="10" Maximum="100" Value="100"
                                VerticalAlignment="Center" ValueChanged="LightRingSliderChanged"/>
                        <TextBlock x:Name="LightRingBrightnessLabel" Text="100%" 
                                   VerticalAlignment="Center" Margin="5,0,0,0" Width="40"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Width:" 
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <Slider x:Name="LightRingWidthSlider" Width="80" Minimum="5" Maximum="100" Value="20"
                                VerticalAlignment="Center" ValueChanged="LightRingSliderChanged"/>
                        <TextBlock x:Name="LightRingWidthLabel" Text="20px" 
                                   VerticalAlignment="Center" Margin="5,0,0,0" Width="40"/>
                    </StackPanel>

                    <CheckBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" x:Name="LightRingHideFromCaptureCheckBox" 
                              Content="Hide from screen capture" VerticalAlignment="Center" Margin="10,0,0,0"
                              ToolTip="Makes the light ring invisible to screen recorders (Windows 10 2004+)"
                              Checked="LightRingSliderChanged" Unchecked="LightRingSliderChanged"/>
                </Grid>
                </Border>

                <!-- Application -->
                <TextBlock Text="Application" Style="{StaticResource SectionHeaderText}" Margin="0,2,0,8"/>
                <Border Style="{StaticResource SettingsCard}" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" x:Name="StartWithWindowsCheckBox"
                                  Content="Start with Windows" VerticalAlignment="Center"
                                  Checked="StartWithWindowsCheckBox_Changed"
                                  Unchecked="StartWithWindowsCheckBox_Changed"/>
                        <TextBlock Grid.Column="1"
                                   Text="Launch Stopwatch Overlay automatically when you sign in."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="24,0,0,0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Expander>

        <!-- Lap Times -->
        <Border Grid.Row="8" Style="{StaticResource ControllerLaps}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Lap times" Style="{StaticResource ControllerLapTitle}" Margin="0,0,0,8"/>
                <Image Grid.Row="0" Source="{StaticResource AcanthusDividerImage}" Height="8"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,1"
                       Stretch="Fill" IsHitTestVisible="False"
                       Visibility="{DynamicResource OrnamentVisibility}"/>
                <Grid Grid.Row="1">
                <ListBox x:Name="LapListBox" 
                         Background="Transparent" BorderThickness="0" MaxHeight="100"
                         Style="{StaticResource ControllerLapList}"
                         ItemContainerStyle="{StaticResource ControllerLapItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource ControllerLapRow}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="LapPlaceholder" Text="Press Win+F2 → L or click Lap to record split times" 
                           Style="{StaticResource ControllerLapPlaceholder}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

    </Grid>
    </ScrollViewer>
        <!-- Status remains visible when countdown editors or laps scroll. -->
        <Border Grid.Row="1" Style="{StaticResource ControllerStatus}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="{DynamicResource MutedStatusBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource ControllerStatusLabel}" MaxWidth="220" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
                <TextBlock x:Name="ShortcutHintText" Grid.Column="1"
                           HorizontalAlignment="Right" Margin="12,0,0,0"
                           Text="Win+F2 → Space Start/Stop  Win+F2 → R Reset  Win+F2 → O Overlay  Win+F2 → L Lap  Win+F2 → C Clock"
                           Style="{StaticResource ControllerShortcutLabel}" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
    </Grid>
    </DockPanel>
    <Rectangle Width="108" Height="106" Fill="{StaticResource PirateCorner}" Clip="M0,0 L108,0 108,16 98,30 30,30 30,97 22,106 0,106 Z" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Style="{StaticResource PirateOnly}"/>
    <Rectangle Width="108" Height="106" Fill="{StaticResource PirateCorner}" Clip="M0,0 L108,0 108,16 98,30 30,30 30,97 22,106 0,106 Z" HorizontalAlignment="Right" VerticalAlignment="Top" RenderTransformOrigin=".5,.5" IsHitTestVisible="False" Style="{StaticResource PirateOnly}"><Rectangle.RenderTransform><ScaleTransform ScaleX="-1"/></Rectangle.RenderTransform></Rectangle>
    <Rectangle Width="108" Height="106" Fill="{StaticResource PirateCorner}" Clip="M0,0 L108,0 108,16 98,30 30,30 30,97 22,106 0,106 Z" HorizontalAlignment="Left" VerticalAlignment="Bottom" RenderTransformOrigin=".5,.5" IsHitTestVisible="False" Style="{StaticResource PirateOnly}"><Rectangle.RenderTransform><ScaleTransform ScaleY="-1"/></Rectangle.RenderTransform></Rectangle>
    <Rectangle Width="108" Height="106" Fill="{StaticResource PirateCorner}" Clip="M0,0 L108,0 108,16 98,30 30,30 30,97 22,106 0,106 Z" HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin=".5,.5" IsHitTestVisible="False" Style="{StaticResource PirateOnly}"><Rectangle.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1"/></Rectangle.RenderTransform></Rectangle>
    </Grid>
</Window>
