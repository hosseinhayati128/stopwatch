<Window x:Class="StopwatchOverlay.TimerEditorWindow" Style="{StaticResource {x:Type Window}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ac="clr-namespace:StopwatchOverlay.Themes"
        Title="Edit Timer"
        Width="600" MinWidth="480"
        SizeToContent="Height" MaxHeight="860"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/PirateDialogStyles.xaml"/>
                <ResourceDictionary Source="Themes/PirateSwitchStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="EditorLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderText}">
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style x:Key="QuickAdjustButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
                <Setter Property="MinWidth" Value="48"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="3,0"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer Style="{StaticResource PirateDialogScroll}">
        <Border MinWidth="440" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                LayoutTransform="{DynamicResource ApplicationScaleTransform}" Style="{StaticResource PirateDialogSurface}" Margin="18">
            <StackPanel Margin="24">
                <Rectangle Style="{StaticResource PirateDialogSkull}"/>
                <Path Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8"
                      Data="{StaticResource AcanthusCrestGeometry}"
                      Fill="{DynamicResource OrnamentAccentBrush}"
                      Stretch="Uniform" Visibility="{DynamicResource OrnamentVisibility}"/>

                <TextBlock x:Name="HeadingText" Text="Edit Timer" Style="{StaticResource DisplayHeadingText}"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock x:Name="SubheadingText" Margin="0,4,0,16"
                           Text="Timer Details"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" FontSize="13"/>

                <!-- Project Assignment -->
                <TextBlock Text="PROJECT" Style="{StaticResource EditorLabel}"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ProjectSelector" MinHeight="38" SelectionChanged="ProjectSelector_SelectionChanged"/>
                    <TextBox x:Name="CustomProjectBox" Grid.Column="0" MinHeight="38" Visibility="Collapsed"
                             VerticalContentAlignment="Center" Style="{StaticResource TimeInputBox}"/>
                    <Button x:Name="ToggleProjectInputButton" Grid.Column="1" Content="New..." MinWidth="60" Margin="8,0,0,0"
                            Style="{StaticResource ModernButton}" Click="ToggleProjectInputButton_Click"/>
                </Grid>

                <!-- Total Time Value Section -->
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,14" Padding="14">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TimeValueLabel" Text="TOTAL ELAPSED TIME" Style="{StaticResource EditorLabel}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LiveTimePreview" Grid.Column="1" Text=""
                                       Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBox x:Name="TimeValueBox"
                                 MinHeight="40"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 VerticalContentAlignment="Center"
                                 Style="{StaticResource TimeInputBox}"
                                 ToolTip="Enter total time as HH:mm:ss, mm:ss, or expressions like 15m, 1h 30m, 0"
                                 TextChanged="TimeValueBox_TextChanged"/>

                        <!-- Adjustment Impact Summary -->
                        <TextBlock x:Name="AdjustmentSummaryText"
                                   Text="Total across recorded segments"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>

                        <!-- Quick Adjust row -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Content="-5m" Style="{StaticResource QuickAdjustButton}" Click="QuickAdjust_Click" Tag="-300"/>
                            <Button Content="-1m" Style="{StaticResource QuickAdjustButton}" Click="QuickAdjust_Click" Tag="-60"/>
                            <Button Content="+1m" Style="{StaticResource QuickAdjustButton}" Click="QuickAdjust_Click" Tag="60"/>
                            <Button Content="+5m" Style="{StaticResource QuickAdjustButton}" Click="QuickAdjust_Click" Tag="300"/>
                            <Button Content="+15m" Style="{StaticResource QuickAdjustButton}" Click="QuickAdjust_Click" Tag="900"/>
                            <Button Content="Zero" Style="{StaticResource QuickAdjustButton}" Click="QuickAdjust_Click" Tag="zero"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Latest Segment Start Time & State Section -->
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,14" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="SegmentHeaderLabel" Text="LATEST SEGMENT START TIME (24-HOUR)" Style="{StaticResource EditorLabel}"/>
                            <TextBox x:Name="StartTimeBox"
                                     MinHeight="38"
                                     MaxLength="8"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource TimeInputBox}"
                                     ToolTip="Latest segment start time as HH:mm:ss. Editing this adjusts elapsed duration."
                                     TextChanged="StartTimeBox_TextChanged"/>
                            <TextBlock x:Name="SegmentDetailText" Text="Latest segment details"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button x:Name="PauseResumeButton" Content="Pause Timer" MinWidth="110" Height="38"
                                    Style="{StaticResource ModernButton}" Click="PauseResumeButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Segments Breakdown Expander -->
                <Expander x:Name="SegmentsExpander" Header="Recorded Segments (0)" Margin="0,0,0,14"
                          Foreground="{DynamicResource PrimaryTextBrush}">
                    <Border Style="{StaticResource SettingsCard}" Margin="0,6,0,0" Padding="10">
                        <ItemsControl x:Name="SegmentsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Duration}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="10,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Expander>

                <!-- Record Options & Timer Actions -->
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,18" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="PROJECT RECORDS" Style="{StaticResource EditorLabel}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="RecordsStatusText" Text="Session is being tracked in project history."
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="DiscardRecordsButton" Content="Discard from Records"
                                MinWidth="150" Height="34" Margin="0,0,8,0"
                                Style="{StaticResource StopButton}" Click="DiscardRecordsButton_Click"
                                ToolTip="Removes this session's time from project records (does not log it)"/>
                        <Button Grid.Column="2" x:Name="DeleteTimerButton" Content="Delete Timer"
                                MinWidth="100" Height="34"
                                Style="{StaticResource ModernButton}" Click="DeleteTimerButton_Click"
                                ToolTip="Close and remove this timer completely"/>
                    </Grid>
                </Border>

                <!-- Bottom dialog buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Cancel" IsCancel="True" MinWidth="90" Height="38"
                            Style="{StaticResource ModernButton}" Click="CancelButton_Click"/>
                    <Button Grid.Column="1" x:Name="UndoPreviousEditButton" Content="Undo Previous Edit"
                            HorizontalAlignment="Right" Margin="0,0,10,0"
                            MinWidth="140" Height="38"
                            Style="{StaticResource ModernButton}"
                            Visibility="Collapsed"
                            ToolTip="Revert the last saved edit and restore previously separated segments (Ctrl+Z)"
                            Click="UndoPreviousEditButton_Click"/>
                    <Button Grid.Column="2" x:Name="SaveButton" Content="Save &amp; Apply" IsDefault="True"
                            MinWidth="130" Height="38"
                            Style="{StaticResource StartButton}" Click="SaveButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
