<Window x:Class="StopwatchOverlay.ConfirmationDialogWindow" Style="{StaticResource {x:Type Window}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height" MaxHeight="780" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/PirateDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer Style="{StaticResource PirateDialogScroll}">
    <Border MinWidth="360" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}" LayoutTransform="{DynamicResource ApplicationScaleTransform}" Style="{StaticResource PirateDialogSurface}" Margin="18">
        <StackPanel Margin="24">
            <Rectangle Style="{StaticResource PirateDialogSkull}"/>
        <Path Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8"
                  Data="{StaticResource AcanthusCrestGeometry}"
                  Fill="{DynamicResource OrnamentAccentBrush}"
                  Stretch="Uniform" Visibility="{DynamicResource OrnamentVisibility}"/>
            <TextBlock x:Name="HeadingText" Style="{StaticResource DisplayHeadingText}"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock x:Name="MessageText" Margin="0,9,0,22"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="0,0,8,0"
                        Style="{StaticResource ModernButton}" Click="CancelButton_Click"/>
                <Button x:Name="ConfirmButton" IsDefault="True" MinWidth="112"
                        Style="{StaticResource StartButton}" Click="ConfirmButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
    </ScrollViewer>
</Window>
