<Window x:Class="StopwatchOverlay.SettingsWindow" Style="{StaticResource {x:Type Window}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ac="clr-namespace:StopwatchOverlay.Themes"
        xmlns:local="clr-namespace:StopwatchOverlay"
        Title="Settings and Overlay Inspector"
        Width="1040" Height="720" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/PirateSwitchStyles.xaml"/>
                <ResourceDictionary Source="Themes/PirateSettingsStyles.xaml"/>
                <ResourceDictionary Source="Themes/Overlay/OverlayStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Background="{DynamicResource AppBackgroundBrush}" LayoutTransform="{DynamicResource ApplicationScaleTransform}">
        <Border DockPanel.Dock="Top" Style="{StaticResource PiratePageHeader}">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,82,0">
                    <Image Width="28" Height="28" Margin="0,0,10,0"
                          Source="{StaticResource AcanthusCrestImage}"
                          Stretch="Uniform" Visibility="{DynamicResource OrnamentVisibility}"/>
                    <Rectangle Width="38" Height="38" Margin="0,0,10,0" Fill="{DynamicResource PirateSkull}"><Rectangle.Style><Style TargetType="Rectangle"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><Trigger Property="ac:PirateVisual.Enabled" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger></Style.Triggers></Style></Rectangle.Style></Rectangle><TextBlock Text="Settings &amp; Overlay Inspector" Style="{StaticResource PiratePageHeading}"/>
                </StackPanel>
                <Button Content="Done" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Height="34" Padding="16,4" Style="{StaticResource StartButton}"
                        Click="DoneButton_Click"/>
            </Grid>
        </Border>

        <ac:SettingsPagePanel>

            <Border Grid.Column="0" Style="{StaticResource PirateSettingsPreview}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Live overlay preview" Style="{StaticResource DisplayHeadingText}" TextWrapping="Wrap"/>
                        <TextBlock Text="Adjust opacity and choose which parts stay visible."
                                   Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Viewbox Grid.Row="1" StretchDirection="DownOnly" Margin="0,8"><StackPanel><Grid x:Name="PreviewThemeScope" VerticalAlignment="Center" HorizontalAlignment="Center"
                          ac:AcanthusVisual.Scope="Collapsed" local:TypographyManager.Scope="Overlay">
                        <Border x:Name="PreviewSurface"
                                Style="{StaticResource NavigatorNativeLayer}"
                                MinWidth="324" Padding="{DynamicResource ThemeOverlayPadding}"
                                BorderBrush="{DynamicResource OverlayChromeBorderBrush}"
                                BorderThickness="{DynamicResource ThemeOverlayFrameBorderThickness}"
                                CornerRadius="{DynamicResource ThemeOverlayCornerRadius}">
                            <StackPanel>
                                <TextBlock x:Name="PreviewTimeText" Text="00:05:10"
                                           HorizontalAlignment="Center"
                                           FontFamily="{DynamicResource ThemeTimerFontFamily}"
                                           FontSize="48" FontWeight="{DynamicResource OverlayTimerFontWeight}"/>
                                <TextBlock x:Name="PreviewProjectText" Text="Programming"
                                           HorizontalAlignment="Center" Margin="{DynamicResource OverlayProjectMargin}"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           FontWeight="{DynamicResource OverlayProjectFontWeight}"
                                           FontSize="{DynamicResource OverlayProjectFontSize}"
                                           Opacity="{DynamicResource OverlayProjectOpacity}"/>
                            </StackPanel>
                        </Border>
                        <!-- Stretch decorations over the content-sized surface. Binding
                             their size back to ActualHeight prevents shrinking after
                             switching away from a taller overlay palette. -->
                        <Grid IsHitTestVisible="False">
                            <Border Margin="8" BorderBrush="{DynamicResource OverlayInnerRuleBrush}"
                                    BorderThickness="1" CornerRadius="8"
                                    Visibility="{DynamicResource OverlayInnerRuleVisibility}"/>
                            <Image Source="{DynamicResource OverlayCornerImage}" Width="18" Height="16"
                                   Visibility="{DynamicResource OverlayCornerVisibility}"
                                   Margin="8,7,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Image Source="{DynamicResource OverlayRightCornerImage}" Width="18" Height="16"
                                   Visibility="{DynamicResource OverlayCornerVisibility}"
                                   Margin="0,7,8,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform><ScaleTransform x:Name="PreviewRightCornerTransform" ScaleX="1"/></Image.RenderTransform>
                            </Image>
                            <Grid Margin="24,0,24,8" Height="18" VerticalAlignment="Bottom"
                                  Visibility="{DynamicResource OverlayCrestVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Height="0.75" VerticalAlignment="Center" Background="{DynamicResource OverlayOrnamentBrush}" Opacity="0.7"/>
                                <Image Grid.Column="1" Width="18" Height="18" Source="{DynamicResource OverlayCrestImage}"/>
                                <Border Grid.Column="2" Height="0.75" VerticalAlignment="Center" Background="{DynamicResource OverlayOrnamentBrush}" Opacity="0.7"/>
                            </Grid>
                            <Image Source="{DynamicResource OverlayLeafImage}" Width="14" Height="3"
                                   Visibility="{DynamicResource OverlayLeafVisibility}"
                                   Margin="0,0,16,9" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                        <ac:NavigatorClock x:Name="PreviewNavigatorClock" Style="{StaticResource NavigatorClockLayer}"
                            Text="{Binding Text, ElementName=PreviewTimeText}" ProjectName="{Binding Text, ElementName=PreviewProjectText}"
                            TextSize="{Binding FontSize, ElementName=PreviewTimeText}" TimerBrush="{Binding Foreground, ElementName=PreviewTimeText}"
                            NameBrush="{Binding Foreground, ElementName=PreviewProjectText}" TimerFont="{Binding FontFamily, ElementName=PreviewTimeText}"/>
                    </Grid>
                        <Border x:Name="PreviewToolbarSurface" HorizontalAlignment="Center"
                                Style="{StaticResource NavigatorToolbarSurfaceStyle}"
                                ac:AcanthusVisual.Scope="Collapsed"
                                BorderBrush="{DynamicResource OverlayToolbarBorderBrush}"
                                Margin="0,8,0,0">
                            <Border.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.MergedDictionaries>
                                        <ResourceDictionary Source="Themes/Overlay/OverlayStyles.xaml"/>
                                    </ResourceDictionary.MergedDictionaries>
                                </ResourceDictionary>
                            </Border.Resources>
                            <ac:NavigatorToolbarPanel ReferenceWidth="{Binding ActualWidth, ElementName=PreviewNavigatorClock}">
                                <Button x:Name="PreviewCloseButton" Style="{StaticResource OverlayCloseButtonStyle}"
                                        ac:NavigatorVisual.Action="Close"
                                        IsTabStop="False" ToolTip="Close timer (preview)">
                                    <Path Width="13" Height="13" Data="M 2,2 L 11,11 M 11,2 L 2,11" Stretch="Fill"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                                <Button x:Name="PreviewPauseButton" Style="{StaticResource OverlayPauseButtonStyle}"
                                        ac:NavigatorVisual.Action="Pause"
                                        IsTabStop="False" ToolTip="Pause or resume timer (preview)">
                                    <Grid Width="14" Height="14">
                                        <Rectangle Width="3" Height="12" HorizontalAlignment="Left" Margin="2,1,0,1"
                                                   RadiusX="1" RadiusY="1"
                                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                        <Rectangle Width="3" Height="12" HorizontalAlignment="Right" Margin="0,1,2,1"
                                                   RadiusX="1" RadiusY="1"
                                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="PreviewResetButton" Style="{StaticResource OverlayActionButtonStyle}"
                                        ac:NavigatorVisual.Action="Reset"
                                        IsTabStop="False" ToolTip="Reset timer (preview)">
                                    <Path Width="15" Height="15" Data="M 12.5,4.5 A 5.5,5.5 0 1 0 13,10 M 12.5,4.5 L 8.5,4.5 M 12.5,4.5 L 12.5,0.5"
                                          Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Button>
                            </ac:NavigatorToolbarPanel>
                        </Border>
                    </StackPanel></Viewbox>
                        <Button Grid.Row="2" Content="Show or hide active overlay" Style="{StaticResource ModernButton}"
                                Click="ShowOverlayButton_Click"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PirateSettingsNavigation}">
                <ListBox x:Name="NavigationList" SelectedIndex="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                         SelectionChanged="NavigationList_SelectionChanged"
                         Background="Transparent" BorderThickness="0">
                    <ListBoxItem Content="Overlay &amp; position" Tag="Overlay" Padding="10" Style="{StaticResource PirateNavigationItem}"/>
                    <ListBoxItem Content="Appearance" Tag="Appearance" Padding="10" Style="{StaticResource PirateNavigationItem}"/>
                    <ListBoxItem Content="Fonts &amp; colors" Tag="Typography" Padding="10" Style="{StaticResource PirateNavigationItem}"/>
                    <ListBoxItem Content="Light ring" Tag="LightRing" Padding="10" Style="{StaticResource PirateNavigationItem}"/>
                    <ListBoxItem Content="Behavior" Tag="Behavior" Padding="10" Style="{StaticResource PirateNavigationItem}"/>
                    <ListBoxItem Content="Application" Tag="Application" Padding="10" Style="{StaticResource PirateNavigationItem}"/>
                    <ListBoxItem Content="Obsidian / Markdown" Tag="Obsidian" Padding="10" Style="{StaticResource PirateNavigationItem}"/>
                    <ListBoxItem Content="Telegram" Tag="Telegram" Padding="10" Style="{StaticResource PirateNavigationItem}"/>
                    <ListBoxItem Content="ActivityWatch" Tag="ActivityWatch" Padding="10" Style="{StaticResource PirateNavigationItem}"/>
                    <ListBoxItem Content="Internet &amp; Network" Tag="Internet" Padding="10" Style="{StaticResource PirateNavigationItem}"/>
                </ListBox>
            </Border>

            <ScrollViewer x:Name="SettingsScrollViewer"
                          Style="{StaticResource PirateSettingsInspector}"
                          Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Focusable="True">
                <Grid Margin="28,24">
                    <StackPanel x:Name="OverlayPanel">
                        <TextBlock Text="Overlay &amp; Position" Style="{StaticResource DisplayHeadingText}"/>
                        <TextBlock Text="Choose where the floating timer appears and how it interacts with capture."
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,22" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Display" Style="{StaticResource SectionHeaderText}"/>
                                <ComboBox x:Name="ScreenCombo" Margin="0,6,0,14"/>
                                <TextBlock Text="Position" Style="{StaticResource SectionHeaderText}"/>
                                <ComboBox x:Name="PositionCombo" Margin="0,6,0,14"/>
                                <CheckBox x:Name="ClickThroughCheck" Content="Click-through" Margin="0,4,0,12" Style="{StaticResource PirateSettingsSwitch}"/>
                                <CheckBox x:Name="HideOverlayCaptureCheck"
                                          Style="{StaticResource PirateSettingsSwitch}"
                                          Content="Hide floating timer from screen capture"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="TypographyPanel" Visibility="Collapsed">
                        <TextBlock Text="Fonts &amp; Colors" Style="{StaticResource DisplayHeadingText}"/>
                        <TextBlock Text="Set text size and color throughout the app. Sizes keep the proportions of headings, labels and timer digits."
                                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,20"/>
                        <Border Style="{StaticResource SettingsCard}"><StackPanel>
                            <TextBlock Text="Global text" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,12"/>
                            <StackPanel x:Name="GlobalTypographyEditor"/>
                            <TextBlock Text="Theme default preserves each theme's readable text and selection colors. Theme presets follow theme changes. Custom colors stay as chosen."
                                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource SettingsCard}"><Expander x:Name="TypographyOverridesExpander" IsExpanded="False">
                            <Expander.Header><TextBlock Text="Customize individual panels" TextWrapping="Wrap"/></Expander.Header>
                            <StackPanel>
                                <TextBlock Text="Check a panel to use its own text settings. Uncheck it to follow global settings; your panel choices are kept."
                                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,16"/>
                                <StackPanel x:Name="SectionTypographyEditors"/>
                            </StackPanel>
                        </Expander></Border>
                    </StackPanel>

                    <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                        <TextBlock Text="Appearance &amp; Background" Style="{StaticResource DisplayHeadingText}"/>
                        <TextBlock Text="Choose application and floating clock themes independently."
                                   Style="{StaticResource AcanthusWrapText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,22"/>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Application theme" Style="{StaticResource SectionHeaderText}"/>
                                <ComboBox x:Name="ThemeCombo" Margin="0,6,0,14"/>
                                <Grid>
                                    <TextBlock Text="Page scale" Style="{StaticResource SectionHeaderText}"/>
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding Value, ElementName=UiScaleSlider, StringFormat={}{0:0}%}"/>
                                </Grid>
                                <Slider Style="{StaticResource PirateSettingsSlider}" x:Name="UiScaleSlider" Minimum="70" Maximum="125" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Margin="0,8,0,4" AutomationProperties.Name="Application page scale"/>
                                <TextBlock Text="Resize text, controls and artwork on every page. Applied when you finish adjusting. Floating timer text has its own size below."
                                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,16"/>
                                <TextBlock Text="Floating clock theme" Style="{StaticResource SectionHeaderText}"/>
                                <ComboBox x:Name="OverlayThemeCombo" Margin="0,6,0,14"
                                          AutomationProperties.Name="Floating clock theme"
                                          ToolTip="Styles the floating clock and hover toolbar only. Your text color, font, size and opacity are preserved. Choose Theme default under Text color to use the clock palette's text colors."/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,12"><TextBlock Text="Text color" Style="{StaticResource SectionHeaderText}"/><ComboBox x:Name="TextColorCombo" Margin="0,6,0,0"/></StackPanel>
                                    <StackPanel Margin="8,0,0,12"><TextBlock Text="Outline color" Style="{StaticResource SectionHeaderText}"/><ComboBox x:Name="BorderColorCombo" Margin="0,6,0,0"/></StackPanel>
                                    <StackPanel Margin="0,0,8,12"><TextBlock Text="Timer font" Style="{StaticResource SectionHeaderText}"/><ComboBox x:Name="FontCombo" Margin="0,6,0,0"/></StackPanel>
                                    <StackPanel Margin="8,0,0,12"><TextBlock Text="Time format" Style="{StaticResource SectionHeaderText}"/><ComboBox x:Name="FormatCombo" Margin="0,6,0,0"/></StackPanel>
                                </UniformGrid>
                                <Grid>
                                    <TextBlock Text="Text size" Style="{StaticResource SectionHeaderText}"/>
                                    <TextBlock x:Name="TextSizeValueText" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Grid>
                                <Slider x:Name="TextSizeSlider" Minimum="16" Maximum="120"
                                        Style="{StaticResource PirateSettingsSlider}"
                                        SmallChange="1" LargeChange="10" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Margin="0,6,0,12"
                                        AutomationProperties.Name="Timer text size"/>
                                <Grid>
                                    <TextBlock Text="Outline thickness" Style="{StaticResource SectionHeaderText}"/>
                                    <TextBlock x:Name="BorderWidthValueText" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Grid>
                                <Slider x:Name="BorderWidthSlider" Minimum="1" Maximum="5"
                                        Style="{StaticResource PirateSettingsSlider}"
                                        SmallChange="1" LargeChange="1" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Margin="0,6,0,12"
                                        AutomationProperties.Name="Timer outline thickness"/>
                                <Grid>
                                    <TextBlock Text="Timer surface opacity" Style="{StaticResource SectionHeaderText}"/>
                                    <TextBlock x:Name="BackgroundOpacityValueText" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Grid>
                                <Slider x:Name="BackgroundOpacitySlider" Minimum="0" Maximum="100"
                                        Style="{StaticResource PirateSettingsSlider}"
                                        SmallChange="1" LargeChange="10" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Margin="0,6,0,14"
                                        AutomationProperties.Name="Timer surface opacity"/>
                                <Expander x:Name="TransparencyDetailsExpander"
                                          IsExpanded="False" Visibility="Collapsed" Margin="0,0,0,14">
                                    <Expander.Header><TextBlock Text="Transparency details" Foreground="{DynamicResource PrimaryTextBrush}"/></Expander.Header>
                                    <StackPanel>
                                        <TextBlock Text="Checked parts stay fully visible. Unchecked parts follow the opacity slider."
                                                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,0,0,12"/>
                                        <CheckBox x:Name="ClockFrameOpaqueCheck" Content="Clock wooden frame and rope" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ClockMapOpaqueCheck" Content="Clock parchment map" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="MetalBorderOpaqueCheck" Content="Metal border" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="MetalFillOpaqueCheck" Content="Metal background" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="TimerTextOpaqueCheck" Content="Timer digits" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ProjectNameOpaqueCheck" Content="Project name" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ControlBoardOpaqueCheck" Content="Button wooden frame and chain" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ControlMapOpaqueCheck" Content="Button blue map" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ControlDialsOpaqueCheck" Content="Button dials and icons"/>
                                    </StackPanel>
                                </Expander>
                                <TextBlock Text="Application background" Style="{StaticResource SectionHeaderText}"/>
                                <Grid Margin="0,6,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="BackgroundCombo" DisplayMemberPath="DisplayLabel"/>
                                    <Button Grid.Column="1" Content="Add" Height="40" Margin="8,0,0,0" Style="{StaticResource ModernButton}" Click="AddBackgroundButton_Click"/>
                                    <Button x:Name="RemoveBackgroundButton" Grid.Column="2" Content="Remove" Height="40" Margin="8,0,0,0" Style="{StaticResource ModernButton}" Click="RemoveBackgroundButton_Click"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Background strength" Style="{StaticResource SectionHeaderText}"/>
                                    <TextBlock x:Name="BackgroundStrengthValueText" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Grid>
                                <Slider x:Name="BackgroundStrengthSlider" Minimum="10" Maximum="45"
                                        Style="{StaticResource PirateSettingsSlider}"
                                        SmallChange="1" LargeChange="5" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Margin="0,6,0,0"
                                        AutomationProperties.Name="Application background strength"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="LightRingPanel" Visibility="Collapsed">
                        <TextBlock Text="Light Ring" Style="{StaticResource DisplayHeadingText}"/>
                        <TextBlock Text="A capture-aware guide around the selected display."
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,22"/>
                        <Border Style="{StaticResource SettingsCard}"><StackPanel>
                            <CheckBox x:Name="LightRingEnabledCheck" Content="Enable light ring" Margin="0,0,0,16" Style="{StaticResource PirateSettingsSwitch}"/>
                            <Grid>
                                <TextBlock Text="Brightness" Style="{StaticResource SectionHeaderText}"/>
                                <TextBlock x:Name="LightRingBrightnessValueText" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Grid>
                            <Slider x:Name="LightRingBrightnessSlider" Minimum="10" Maximum="100"
                                    Style="{StaticResource PirateSettingsSlider}"
                                    SmallChange="1" LargeChange="10" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Margin="0,6,0,16"
                                    AutomationProperties.Name="Light ring brightness"/>
                            <Grid>
                                <TextBlock Text="Ring width" Style="{StaticResource SectionHeaderText}"/>
                                <TextBlock x:Name="LightRingWidthValueText" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Grid>
                            <Slider x:Name="LightRingWidthSlider" Minimum="5" Maximum="100"
                                    Style="{StaticResource PirateSettingsSlider}"
                                    SmallChange="1" LargeChange="10" TickFrequency="1"
                                    IsSnapToTickEnabled="True" Margin="0,6,0,16"
                                    AutomationProperties.Name="Light ring width"/>
                            <CheckBox x:Name="LightRingCaptureCheck" Content="Hide ring from screen capture" Style="{StaticResource PirateSettingsSwitch}"/>
                        </StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="BehaviorPanel" Visibility="Collapsed">
                        <TextBlock Text="Behavior" Style="{StaticResource DisplayHeadingText}"/>
                        <TextBlock Text="Keep recording and presentation workflows predictable."
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,22"/>
                        <Border Style="{StaticResource SettingsCard}"><StackPanel>
                            <CheckBox x:Name="AutoStartCheck" Content="Auto-start when the overlay is shown" Margin="0,0,0,14" Style="{StaticResource PirateSettingsSwitch}"/>
                            <CheckBox x:Name="RecCheck" Content="Show REC indicator" Margin="0,0,0,14" Style="{StaticResource PirateSettingsSwitch}"/>
                            <CheckBox x:Name="BlinkCheck" Content="Blink timer colon" Margin="0,0,0,14" Style="{StaticResource PirateSettingsSwitch}"/>
                            <CheckBox x:Name="SmartInputCheck" Content="Use smart countdown input" Margin="0,0,0,16" Style="{StaticResource PirateSettingsSwitch}"/>
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="Command chaining timeout" Style="{StaticResource SectionHeaderText}"/>
                                <TextBlock x:Name="CommandChainingTimeoutValueText" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Grid>
                            <Slider x:Name="CommandChainingTimeoutSlider" Minimum="0.2" Maximum="2.0"
                                    Style="{StaticResource PirateSettingsSlider}"
                                    SmallChange="0.1" LargeChange="0.5" TickFrequency="0.1"
                                    IsSnapToTickEnabled="True" Margin="0,6,0,4"
                                    AutomationProperties.Name="Command chaining timeout"/>
                            <TextBlock Text="Continuation window (seconds) to press subsequent commands after a command executes."
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                        </StackPanel></Border>

                        <Border Style="{StaticResource SettingsCard}" Margin="0,16,0,0"><StackPanel>
                            <TextBlock Text="Idle Stop (Inactivity Detection)" Style="{StaticResource SectionHeaderText}"/>
                            <TextBlock Text="Automatically stop or pause running stopwatch timers when the system is idle for a specified duration."
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,16"/>

                            <CheckBox x:Name="IdleStopUnnamedCheck" Content="Enable idle stop for unnamed timers (default: off)" Margin="0,0,0,14" Style="{StaticResource PirateSettingsSwitch}"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Default idle timeout (minutes)" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Used when a project does not have a specific duration." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                                <TextBox x:Name="IdleStopDefaultTimeoutTextBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center" TextAlignment="Center" Padding="4,0" FontSize="12" FontFamily="{DynamicResource AppFontFamily}"/>
                            </Grid>

                            <CheckBox x:Name="IdleStopSubtractCheck" Content="Subtract idle duration when stopping (reverts time to when inactivity started)" Margin="0,0,0,16" Style="{StaticResource PirateSettingsSwitch}"/>

                            <Separator Margin="0,0,0,16" Background="{DynamicResource SeparatorBrush}" Opacity="0.5"/>

                            <TextBlock Text="Per-Project Idle Settings" Style="{StaticResource SectionHeaderText}"/>
                            <TextBlock Text="Activate or deactivate idle stopping for individual projects (default: deactive for all projects)."
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="IdleProjectComboBox" Height="34" VerticalContentAlignment="Center" SelectionChanged="IdleProjectComboBox_SelectionChanged"/>
                            </Grid>

                            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox x:Name="IdleProjectActiveCheck" Content="Active for selected project" Margin="0,0,0,10" Style="{StaticResource PirateSettingsSwitch}" Click="IdleProjectActiveCheck_Click"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Project idle timeout (minutes)" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBox x:Name="IdleProjectTimeoutTextBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center" TextAlignment="Center" Padding="4,0" FontSize="12" FontFamily="{DynamicResource AppFontFamily}" TextChanged="IdleProjectTimeoutTextBox_TextChanged"/>
                                    </Grid>
                                    <TextBlock x:Name="IdleProjectStatusSummaryText" Text="Status: Deactive" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Project Rules Overview" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,6"/>
                            <ItemsControl x:Name="IdleProjectsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,3" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ProjectName}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{Binding StatusBrush}" FontSize="11" Margin="12,0"/>
                                                <Button Grid.Column="2" Content="{Binding ActionButtonText}" Height="28" Padding="12,0" FontSize="11" Style="{StaticResource ModernButton}" Tag="{Binding ProjectName}" Click="IdleProjectQuickToggle_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="ApplicationPanel" Visibility="Collapsed">
                        <TextBlock Text="Application" Style="{StaticResource DisplayHeadingText}"/>
                        <TextBlock Text="Startup and persistence preferences."
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,22"/>
                        <Border Style="{StaticResource SettingsCard}"><StackPanel>
                            <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows" Style="{StaticResource PirateSettingsSwitch}"/>
                            <TextBlock Text="Close button action" Style="{StaticResource SectionHeaderText}" Margin="0,16,0,6"/>
                            <ComboBox x:Name="CloseActionCombo" Margin="0,0,0,6">
                                <ComboBoxItem Content="Ask every time"/>
                                <ComboBoxItem Content="Minimize to system tray"/>
                                <ComboBoxItem Content="Exit application completely"/>
                            </ComboBox>
                            <TextBlock Text="Choose whether clicking the close button on the main window asks, minimizes to the notification area, or exits completely."
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,16"/>
                            <TextBlock Text="Your theme, backgrounds, timers, project history, positions, and shortcuts remain stored by the existing recovery system."
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,0"/>
                        </StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="ObsidianPanel" Visibility="Collapsed">
                        <TextBlock Text="Obsidian &amp; Markdown" Style="{StaticResource DisplayHeadingText}"/>
                        <TextBlock Text="Log completed timer sessions into your Obsidian vault as a structured Markdown table for reporting and AI analysis."
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,22" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource SettingsCard}"><StackPanel>
                            <CheckBox x:Name="ObsidianAutoSyncCheck" Content="Enable automatic export to Obsidian / Markdown" Margin="0,0,0,14" Style="{StaticResource PirateSettingsSwitch}"/>
                            <CheckBox x:Name="ObsidianLogUnnamedCheck" Content="Include unnamed timers (logged as 'Timer 1', 'Timer 2', etc.)" Margin="0,0,0,16" Style="{StaticResource PirateSettingsSwitch}"/>

                            <TextBlock Text="Target folder (Obsidian vault)" Style="{StaticResource SectionHeaderText}"/>
                            <Grid Margin="0,6,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ObsidianFolderTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                                         FontSize="12" FontFamily="{DynamicResource AppFontFamily}"/>
                                <Button x:Name="BrowseObsidianFolderButton" Grid.Column="1" Content="Browse..." Height="34" Margin="8,0,0,0"
                                        Padding="14,0" Style="{StaticResource ModernButton}" Click="BrowseObsidianFolderButton_Click"/>
                            </Grid>

                            <TextBlock Text="File name" Style="{StaticResource SectionHeaderText}"/>
                            <TextBox x:Name="ObsidianFileNameTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,6,0,14"
                                     FontSize="12" FontFamily="{DynamicResource AppFontFamily}"/>

                            <TextBlock Text="Full file path" Style="{StaticResource SectionHeaderText}"/>
                            <TextBlock x:Name="ObsidianPathPreviewText" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,4,0,16"/>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button x:Name="ExportNowButton" Content="Export All History Now" Height="34" Padding="16,0"
                                        Style="{StaticResource ModernButton}" Click="ExportNowButton_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="ExportStatusText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="TelegramPanel" Visibility="Collapsed">
                        <TextBlock Text="Telegram Integration" Style="{StaticResource DisplayHeadingText}"/>
                        <TextBlock Text="Automatically forward Quick Notes, Todos, and Reminders to your Telegram supergroup or topics."
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,22" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource SettingsCard}"><StackPanel>
                            <CheckBox x:Name="TelegramEnabledCheck" Content="Enable Telegram sync for notes, todos, and reminders" Margin="0,0,0,16" Style="{StaticResource PirateSettingsSwitch}"/>

                            <TextBlock Text="Bot Token" Style="{StaticResource SectionHeaderText}"/>
                            <TextBox x:Name="TelegramBotTokenTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,6,0,6"
                                     FontSize="12" FontFamily="{DynamicResource AppFontFamily}"/>
                            <TextBlock Text="The HTTP API token provided by @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)."
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <TextBlock Text="Group / Supergroup Chat ID" Style="{StaticResource SectionHeaderText}"/>
                            <TextBox x:Name="TelegramChatIdTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,6,0,6"
                                     FontSize="12" FontFamily="{DynamicResource AppFontFamily}"/>
                            <TextBlock Text="Target supergroup ID (usually starts with -100, e.g. -1001234567890). Make sure your bot is added to the group."
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <TextBlock Text="Topic IDs (message_thread_id for Supergroup Topics)" Style="{StaticResource SectionHeaderText}"/>
                            <TextBlock Text="In a forum supergroup, each topic has a unique Topic ID. Leave blank to send to General / main chat."
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Quick Notes Topic:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBox x:Name="TelegramNotesTopicTextBox" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                                         FontSize="12" FontFamily="{DynamicResource AppFontFamily}"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Todos Topic:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBox x:Name="TelegramTodosTopicTextBox" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                                         FontSize="12" FontFamily="{DynamicResource AppFontFamily}"/>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Reminders Topic:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBox x:Name="TelegramRemindersTopicTextBox" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                                         FontSize="12" FontFamily="{DynamicResource AppFontFamily}"/>
                            </Grid>

                            <TextBlock Text="Tip: In Telegram, right-click any message in a topic, choose 'Copy Message Link', and copy the middle number (e.g. t.me/c/GROUP_ID/TOPIC_ID/MSG_ID)."
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button x:Name="TestTelegramButton" Content="Test Connection" Height="34" Padding="16,0"
                                        Style="{StaticResource ModernButton}" Click="TestTelegramButton_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TelegramStatusText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel></Border>

                        <Border Style="{StaticResource SettingsCard}" Margin="0,16,0,0"><StackPanel>
                            <TextBlock Text="Offline Queue &amp; Delivery" Style="{StaticResource SectionHeaderText}"/>
                            <TextBlock Text="Notes, todos, and reminders created while offline are queued locally and automatically sent to Telegram when your connection is restored."
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,14"/>

                            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TelegramOutboxStatusText" Text="Outbox: 0 notes pending" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock x:Name="TelegramOutboxDetailText" Text="All notes are up to date." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="SendPendingNotesButton" Content="Send Pending Notes Now" Height="32" Padding="14,0" Margin="0,0,8,0"
                                                Style="{StaticResource ModernButton}" Click="SendPendingNotesButton_Click"/>
                                        <Button x:Name="ScanVaultNotesButton" Content="Scan Vault for Unsent Notes" Height="32" Padding="14,0"
                                                Style="{StaticResource ModernButton}" Click="ScanVaultNotesButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="ActivityWatchPanel" Visibility="Collapsed">
                        <TextBlock Text="ActivityWatch Integration" Style="{StaticResource DisplayHeadingText}"/>
                        <TextBlock Text="Sync background activity (active applications, Obsidian notes, VLC media, and Chrome tabs) into your Obsidian vault with idle/AFK filtering."
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,22" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource SettingsCard}"><StackPanel>
                            <CheckBox x:Name="ActivityWatchEnabledCheck" Content="Enable ActivityWatch integration" Margin="0,0,0,14" Style="{StaticResource PirateSettingsSwitch}"/>
                            <CheckBox x:Name="ActivityWatchSyncOnStopwatchCheck" Content="Auto-sync activity when stopwatch sessions are saved to Obsidian" Margin="0,0,0,14" Style="{StaticResource PirateSettingsSwitch}"/>
                            <CheckBox x:Name="ActivityWatchPeriodicSyncCheck" Content="Periodically sync activity to Obsidian in the background" Margin="0,0,0,14" Style="{StaticResource PirateSettingsSwitch}"/>
                            <TextBlock Text="Sync interval (minutes)" Style="{StaticResource SectionHeaderText}"/>
                            <TextBox x:Name="ActivityWatchPeriodicSyncIntervalTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,6,0,6"
                                     FontSize="12" FontFamily="{DynamicResource AppFontFamily}"/>
                            <TextBlock Text="How often to auto-sync background activity to Obsidian (default: 60 minutes / 1 hour)."
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>
                            <CheckBox x:Name="ActivityWatchIncludeTitlesCheck" Content="Include window &amp; document titles (Obsidian note names, VLC video titles, etc.)" Margin="0,0,0,14" Style="{StaticResource PirateSettingsSwitch}"/>
                            <CheckBox x:Name="ActivityWatchIncludeWebCheck" Content="Include browser web activity (Chrome tab titles &amp; web domains)" Margin="0,0,0,16" Style="{StaticResource PirateSettingsSwitch}"/>

                            <TextBlock Text="ActivityWatch Server URL" Style="{StaticResource SectionHeaderText}"/>
                            <TextBox x:Name="ActivityWatchServerUrlTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,6,0,6"
                                     FontSize="12" FontFamily="{DynamicResource AppFontFamily}"/>
                            <TextBlock Text="Local REST API address for ActivityWatch (default: http://localhost:5600)."
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <TextBlock Text="Export file name (in Obsidian Vault)" Style="{StaticResource SectionHeaderText}"/>
                            <TextBox x:Name="ActivityWatchFileNameTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,6,0,6"
                                     FontSize="12" FontFamily="{DynamicResource AppFontFamily}"/>
                            <TextBlock Text="Saved as a separate Markdown file in your configured Obsidian vault folder."
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <TextBlock Text="Minimum active duration (seconds)" Style="{StaticResource SectionHeaderText}"/>
                            <TextBox x:Name="ActivityWatchMinDurationTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,6,0,6"
                                     FontSize="12" FontFamily="{DynamicResource AppFontFamily}"/>
                            <TextBlock Text="Ignore quick window switches or alt-tabs shorter than this duration (default: 15 seconds)."
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button x:Name="TestActivityWatchButton" Content="Test Connection" Height="34" Padding="16,0"
                                        Style="{StaticResource ModernButton}" Click="TestActivityWatchButton_Click"/>
                                <Button x:Name="SyncActivityWatchNowButton" Content="Sync Today's Activity Now" Height="34" Padding="16,0" Margin="10,0,0,0"
                                        Style="{StaticResource ModernButton}" Click="SyncActivityWatchNowButton_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="ActivityWatchStatusText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="InternetPanel" Visibility="Collapsed">
                        <TextBlock Text="Internet &amp; Network Monitoring" Style="{StaticResource DisplayHeadingText}"/>
                        <TextBlock Text="Monitor internet connection status, latency (ping), download speed, and connected Wi-Fi / network adapter in the background and log to Obsidian."
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,22" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource SettingsCard}"><StackPanel>
                            <CheckBox x:Name="InternetMonitorEnabledCheck" Content="Enable background internet &amp; network monitoring" Margin="0,0,0,14" Style="{StaticResource PirateSettingsSwitch}"/>
                            <CheckBox x:Name="InternetMonitorOnlyDuringTimersCheck" Content="Only check while a stopwatch timer is running (saves bandwidth)" Margin="0,0,0,16" Style="{StaticResource PirateSettingsSwitch}"/>

                            <TextBlock Text="Check interval (minutes)" Style="{StaticResource SectionHeaderText}"/>
                            <TextBox x:Name="InternetCheckIntervalTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,6,0,6"
                                     FontSize="12" FontFamily="{DynamicResource AppFontFamily}"/>
                            <TextBlock Text="How often to test connection speed and latency (default: 10 minutes)."
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <TextBlock Text="Export file name (in Obsidian Vault)" Style="{StaticResource SectionHeaderText}"/>
                            <TextBox x:Name="InternetFileNameTextBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,6,0,6"
                                     FontSize="12" FontFamily="{DynamicResource AppFontFamily}"/>
                            <TextBlock Text="Logged as a separate Markdown file in your Obsidian vault folder (default: Internet Log.md)."
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button x:Name="TestInternetButton" Content="Test Connection Now" Height="34" Padding="16,0"
                                        Style="{StaticResource ModernButton}" Click="TestInternetButton_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="InternetStatusText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel></Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </ac:SettingsPagePanel>
    </DockPanel>
</Window>
