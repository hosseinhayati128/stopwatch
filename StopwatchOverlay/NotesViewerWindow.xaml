<Window x:Class="StopwatchOverlay.NotesViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ac="clr-namespace:StopwatchOverlay.Themes"
        Title="Notes, Todos &amp; Reminders"
        ac:AcanthusVisual.Scope="{DynamicResource OrnamentVisibility}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="640"
        Height="470"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Overlay/OverlayStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TabFilterButtonStyle" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
                <Setter Property="Padding" Value="12,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="TabBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource ThemeItemCornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PrimaryActionBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource OnActionTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource DialogSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="{DynamicResource ThemePanelBorderThickness}"
            CornerRadius="{DynamicResource ThemePanelCornerRadius}"
            Margin="8"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="4" Opacity="0.55"/>
        </Border.Effect>

        <Grid Margin="18,14,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <Path Width="22" Height="22" HorizontalAlignment="Center" Margin="0,0,0,6"
                      Data="{StaticResource AcanthusCrestGeometry}"
                      Fill="{DynamicResource OrnamentAccentBrush}"
                      Stretch="Uniform" Visibility="{DynamicResource OrnamentVisibility}"/>

                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✦ " Foreground="{DynamicResource AccentBrush}" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="Notes, Todos &amp; Reminders" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold"
                                   FontFamily="{DynamicResource DisplayHeadingFontFamily}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Countdown badge -->
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="{DynamicResource ThemeControlBorderThickness}"
                                CornerRadius="{DynamicResource ThemeControlCornerRadius}" Padding="8,3" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱ " Foreground="{DynamicResource AccentBrush}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CountdownText" Text="Auto-closing in 30s"
                                           Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Medium"
                                           FontFamily="{DynamicResource AppFontFamily}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="CloseButton"
                                Style="{StaticResource OverlayCloseButtonStyle}"
                                Width="22" Height="22"
                                ToolTip="Close (Enter or Esc)"
                                Click="CloseButton_Click">
                            <Path Width="9" Height="9"
                                  Data="M 1,1 L 8,8 M 8,1 L 1,8"
                                  Stretch="Fill"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Filter Tabs -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{DynamicResource ThemeControlCornerRadius}" Padding="3" Margin="0,0,0,12" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FilterAllRadio" Content="All" IsChecked="True"
                                 Style="{StaticResource TabFilterButtonStyle}"
                                 Checked="FilterRadio_Checked"/>
                    <RadioButton x:Name="FilterTodosRadio" Content="Todos"
                                 Style="{StaticResource TabFilterButtonStyle}"
                                 Checked="FilterRadio_Checked"/>
                    <RadioButton x:Name="FilterNotesRadio" Content="Notes"
                                 Style="{StaticResource TabFilterButtonStyle}"
                                 Checked="FilterRadio_Checked"/>
                    <RadioButton x:Name="FilterRemindersRadio" Content="Reminders"
                                 Style="{StaticResource TabFilterButtonStyle}"
                                 Checked="FilterRadio_Checked"/>
                </StackPanel>
            </Border>

            <!-- Content List -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel x:Name="ItemsContainer">
                    <TextBlock x:Name="EmptyMessageText"
                               Text="Loading notes..."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="13"
                               FontFamily="{DynamicResource AppFontFamily}"
                               HorizontalAlignment="Center"
                               Margin="0,40,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <TextBlock Text="Press Enter or Esc to close immediately"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="11"
                           FontFamily="{DynamicResource AppFontFamily}"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="VaultLocationText"
                           Text=""
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="11"
                           FontFamily="{DynamicResource AppFontFamily}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="350"/>
            </Grid>
        </Grid>
    </Border>
</Window>
