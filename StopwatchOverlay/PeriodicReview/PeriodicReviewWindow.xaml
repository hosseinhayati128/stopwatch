<Window x:Class="StopwatchOverlay.PeriodicReview.PeriodicReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activity &amp; Time Review"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        Width="980"
        Height="640"
        MinWidth="850"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DialogSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecBorder" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SecBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SecBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="{DynamicResource ThemePanelBorderThickness}"
            CornerRadius="{DynamicResource ThemePanelCornerRadius}"
            Padding="22,18"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" Direction="270" ShadowDepth="6" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Row -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✦ " Foreground="{DynamicResource AccentBrush}" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Activity &amp; Time Review"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="17"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   FontWeight="SemiBold"/>
                        <Border Background="{DynamicResource DialogSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="14,0,0,0">
                            <TextBlock x:Name="PeriodRangeBadge" Text="📅 14:00 – 14:30 (30m)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="StepSubtitleText"
                               Text="Step 1: Select the projects you worked on in order (or breaks), guided by your ActivityWatch percentage report."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="11.5"
                               FontFamily="{DynamicResource AppFontFamily}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Step Indicator on Top Right -->
                <Border Grid.Column="1" Background="{DynamicResource DialogSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="StepIndicatorBadge" Text="Step 1 of 2: Projects &amp; Overview" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                </Border>
            </Grid>

            <!-- 2. Body: Step 1 vs Step 2 View Containers -->
            <Grid Grid.Row="1" Margin="0,0,0,14">

                <!-- ========== STEP 1 CONTAINER ========== -->
                <Grid x:Name="Step1Container" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Selectable Project Cards -->
                    <Border Grid.Column="0" Background="{DynamicResource DialogSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="📋 Select Projects Worked On" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Click cards in the order you worked on them. Click again to deselect." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Project Cards Wrap Container -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <WrapPanel x:Name="ProjectCardsContainer" Margin="0,0,0,8">
                                        <!-- Dynamically populated in code -->
                                    </WrapPanel>

                                    <!-- Add New Project Inline Bar -->
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,6,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="NewProjectTextBox" Height="28" Padding="6,2" FontSize="11.5"
                                                     VerticalContentAlignment="Center"
                                                     Background="{DynamicResource DialogSurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                     KeyDown="NewProjectTextBox_KeyDown"
                                                     ToolTip="Enter a new project name"/>
                                            <Button x:Name="AddNewProjectButton" Grid.Column="1" Content="＋ Add Project" Height="28" Padding="10,0" Margin="6,0,0,0"
                                                    Style="{StaticResource SecondaryButton}" Click="AddNewProjectButton_Click"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Step 1 Bottom Bar: Selection Order Preview & Continue Button -->
                            <Border Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Selected Sequence:" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="SelectedSequenceText" Text="None selected (click cards above)" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button x:Name="ContinueToStep2Button" Grid.Column="1" Content="Continue ➔" Height="30" Padding="14,0"
                                            Style="{StaticResource ActionButton}" Click="ContinueToStep2Button_Click"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Spacer Column 1 -->

                    <!-- Right Column: User-Friendly ActivityWatch Report (Percentages) -->
                    <Border Grid.Column="2" Background="{DynamicResource DialogSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="📊 Activity Breakdown &amp; Percentages" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Grouped summary of foreground apps, websites, and idle time." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Margin / Threshold Stepper -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Min:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Minimum activity % to show as an individual card"/>
                                    <Button x:Name="DecreaseThresholdButton" Content="−" Width="24" Height="24" Style="{StaticResource SecondaryButton}" Padding="0" Click="DecreaseThresholdButton_Click" ToolTip="Show more details (decrease min % threshold)"/>
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="4,0" ToolTip="Current threshold: activities below this are grouped into 'Others'">
                                        <TextBlock x:Name="ThresholdPercentText" Text="3%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <Button x:Name="IncreaseThresholdButton" Content="＋" Width="24" Height="24" Style="{StaticResource SecondaryButton}" Padding="0" Click="IncreaseThresholdButton_Click" ToolTip="Group more into Others (increase min % threshold)"/>
                                </StackPanel>
                            </Grid>

                            <!-- Activity Summary List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ActivitySummariesContainer">
                                    <!-- Populated dynamically with percentage cards -->
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Offline / Empty Status Banner -->
                            <Border x:Name="ActivityWatchStatusCard" Grid.Row="1"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="16" Margin="12"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                                <StackPanel MaxWidth="360" HorizontalAlignment="Center">
                                    <TextBlock x:Name="ActivityWatchStatusHeading" Text="⚠️ ActivityWatch is Offline" FontWeight="Bold" FontSize="13.5"
                                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="ActivityWatchStatusMessage"
                                               Text="Cannot connect to ActivityWatch at localhost:5600."
                                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14"/>
                                    <Button x:Name="RetryActivityWatchButton" Content="Retry Connection" Height="30" Padding="14,0"
                                            Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Click="RetryActivityWatchButton_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>


                <!-- ========== STEP 2 CONTAINER ========== -->
                <Grid x:Name="Step2Container" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Allocation Summary & Visual Multi-Color Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource DialogSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Step2AllocationSummaryText" Text="Allocated: 0m / 30m · Remaining: 30m (Unallocated)"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="💡 Hover over any card for details (hours, %, interval)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                           Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Visual Stacked Distribution Bar (Interactive Timeline Track) -->
                            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Height="34" SnapsToDevicePixels="True" ClipToBounds="True">
                                <Grid x:Name="DistributionBarContainer">
                                    <!-- Populated dynamically with interactive draggable colored bars and unallocated gaps -->
                                </Grid>
                            </Border>

                            <!-- Timeline Time Scale Markers -->
                            <Grid Margin="4,4,4,0">
                                <TextBlock x:Name="TimelineScaleStartText" Text="10:00" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TimelineScaleMidText" Text="10:15" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TimelineScaleEndText" Text="10:30" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Step 2 Dual Column: Left = Duration Sliders; Right = Sequential Timeline Preview -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Selected Project Duration Controls -->
                        <Border Grid.Column="0" Background="{DynamicResource DialogSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="⏱️ Allocate Time for Each Item" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Set durations using the sliders or +/- buttons. Order can be moved with ▲ ▼." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="AllocatedProjectsContainer">
                                        <!-- Dynamically populated with slider cards -->
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Spacer Column 1 -->

                        <!-- Right Column: Chronological Timeline Preview -->
                        <Border Grid.Column="2" Background="{DynamicResource DialogSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="📅 Timeline Sequence Preview" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="How intervals will be saved in your stopwatch history and .md file:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="TimelinePreviewContainer">
                                        <!-- Populated dynamically with timeline cards -->
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ========== STEP 3 CONTAINER: FEELINGS & MOOD ========== -->
                <Grid x:Name="Step3Container" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Mood Score Slider & Visual Feedback -->
                    <Border Grid.Column="0" Background="{DynamicResource DialogSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                <TextBlock Text="🌟 How Was Your Mood?" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Rate how you felt on a scale of 1.0 to 10.0 (drag slider, scroll, or use ± buttons)."
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Big Visual Score Badge Card -->
                            <Border Grid.Row="1" Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Score Number Display -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="MoodScoreBigText" Text="7.0" FontSize="38" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="/10" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                                    </StackPanel>

                                    <!-- Mood State Descriptor & Emoji -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Border x:Name="MoodEmojiBadge" Background="{DynamicResource DialogSurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="14" Padding="10,4" HorizontalAlignment="Left">
                                            <TextBlock x:Name="MoodDescriptorText" Text="😊 Good / Content" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <TextBlock x:Name="MoodSubtext" Text="Positive &amp; productive mindset" FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="2,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Slider with Minus/Plus 0.1 Steppers -->
                            <Grid Grid.Row="2" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- -0.1 Stepper Button -->
                                <Button x:Name="DecreaseMoodButton" Grid.Column="0" Content="− 0.1" Width="44" Height="30"
                                        Style="{StaticResource SecondaryButton}" Padding="0" Click="DecreaseMoodButton_Click"
                                        ToolTip="Decrease mood score by 0.1"/>

                                <!-- Scroll bar / Slider (1.0 to 10.0, 0.1 precision) -->
                                <Slider x:Name="MoodSlider" Grid.Column="1" Margin="10,0"
                                        Minimum="1.0" Maximum="10.0" Value="7.0"
                                        SmallChange="0.1" LargeChange="0.5"
                                        IsSnapToTickEnabled="False"
                                        VerticalAlignment="Center"
                                        ValueChanged="MoodSlider_ValueChanged"
                                        PreviewMouseWheel="MoodSlider_PreviewMouseWheel"/>

                                <!-- +0.1 Stepper Button -->
                                <Button x:Name="IncreaseMoodButton" Grid.Column="2" Content="+ 0.1" Width="44" Height="30"
                                        Style="{StaticResource SecondaryButton}" Padding="0" Click="IncreaseMoodButton_Click"
                                        ToolTip="Increase mood score by 0.1"/>
                            </Grid>

                            <!-- Scale Range Markers -->
                            <Grid Grid.Row="3" Margin="46,0,46,14">
                                <TextBlock Text="1.0 (Low)" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Left"/>
                                <TextBlock Text="5.0 (Neutral)" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="10.0 (Thrilled)" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Quick Preset Pills -->
                            <StackPanel Grid.Row="4" VerticalAlignment="Top">
                                <TextBlock Text="Quick Jump Presets:" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                <WrapPanel x:Name="MoodPresetsContainer">
                                    <!-- Populated with pills: 1.0, 3.0, 5.0, 7.0, 8.5, 10.0 -->
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right Column: Keywords / Feelings Tags & Notes -->
                    <Border Grid.Column="2" Background="{DynamicResource DialogSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="🏷️ What Were You Feeling?" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Click keywords to select or deselect. You can pick multiple."
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Keyword Tags & Custom Tag Input -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <!-- WrapPanel for Keyword Chips -->
                                    <WrapPanel x:Name="FeelingsKeywordsContainer" Margin="0,0,0,10">
                                        <!-- Dynamic keyword chips -->
                                    </WrapPanel>

                                    <!-- Add Custom Keyword Bar -->
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,6,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="NewKeywordTextBox" Height="28" Padding="6,2" FontSize="11.5"
                                                     VerticalContentAlignment="Center"
                                                     Background="{DynamicResource DialogSurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                     KeyDown="NewKeywordTextBox_KeyDown"
                                                     ToolTip="Type a custom feeling (e.g. Grateful, Distracted, Creative) and press Enter"/>
                                            <Button x:Name="AddNewKeywordButton" Grid.Column="1" Content="＋ Add Tag" Height="28" Padding="10,0" Margin="6,0,0,0"
                                                    Style="{StaticResource SecondaryButton}" Click="AddNewKeywordButton_Click"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Bottom: Optional Quick Reflection / Note -->
                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <TextBlock Text="Optional Reflection / Note:" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="MoodNoteTextBox" Height="48" Padding="8,6" FontSize="11.5"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                         ToolTip="Any note about why you felt this way or what influenced your mood"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 3. Footer Bar -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="FooterShortcutHintText"
                           Text="Press Esc to skip without changes"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="11.5"
                           FontFamily="{DynamicResource AppFontFamily}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Step 1 Footer Buttons -->
                    <Button x:Name="Step1SkipButton" Content="Skip (Esc)" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="SkipReportButton_Click"/>
                    
                    <!-- Step 2 Footer Buttons -->
                    <Button x:Name="Step2BackButton" Content="⬅ Back" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Click="Step2BackButton_Click"/>
                    <Button x:Name="Step2SkipFeelingsButton" Content="Skip Feelings &amp; Save" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Click="Step2SkipFeelingsButton_Click"/>
                    <Button x:Name="Step2VerifyButton" Content="✓ Verify &amp; Save (Enter)" Margin="0,0,10,0" Style="{StaticResource ActionButton}" Visibility="Collapsed" Click="Step2VerifyButton_Click"/>
                    <Button x:Name="Step2ContinueButton" Content="Next: Feelings ➔" Style="{StaticResource ActionButton}" Visibility="Collapsed" Click="Step2ContinueButton_Click"/>

                    <!-- Step 3 Footer Buttons -->
                    <Button x:Name="Step3BackButton" Content="⬅ Back" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Click="Step3BackButton_Click"/>
                    <Button x:Name="Step3SkipButton" Content="Skip Feelings (Save Time Only)" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Click="Step3SkipButton_Click"/>
                    <Button x:Name="Step3SaveButton" Content="✓ Save &amp; Complete (Enter)" Style="{StaticResource ActionButton}" Visibility="Collapsed" Click="Step3SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
