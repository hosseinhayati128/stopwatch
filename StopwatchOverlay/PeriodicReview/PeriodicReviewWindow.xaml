<Window x:Class="StopwatchOverlay.PeriodicReview.PeriodicReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activity &amp; Time Review"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        Width="980"
        Height="620"
        MinWidth="850"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DialogSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecBorder" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SecBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="{DynamicResource ThemePanelBorderThickness}"
            CornerRadius="{DynamicResource ThemePanelCornerRadius}"
            Padding="22,18"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" Direction="270" ShadowDepth="6" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Row -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✦ " Foreground="{DynamicResource AccentBrush}" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Activity &amp; Time Review"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="17"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   FontWeight="SemiBold"/>
                        <Border Background="{DynamicResource DialogSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="14,0,0,0">
                            <TextBlock x:Name="PeriodRangeBadge" Text="📅 14:00 – 14:30 (30m)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Review foreground ActivityWatch logs on the left and assign/adjust project stopwatch time on the right."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="11.5"
                               FontFamily="{DynamicResource AppFontFamily}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Filter Controls on Top Right -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Filter blips &lt;" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="FilterDurationTextBox" Width="44" Height="28" TextAlignment="Center" VerticalContentAlignment="Center"
                             Text="15" FontSize="11.5" FontFamily="{DynamicResource AppFontFamily}"
                             Background="{DynamicResource DialogSurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,4,0"
                             KeyDown="FilterDurationTextBox_KeyDown"/>
                    <TextBlock Text="sec" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="ApplyFilterButton" Content="Apply" Height="28" Padding="10,0" Style="{StaticResource SecondaryButton}" Click="ApplyFilterButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- 2. Dual Column Body -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: ActivityWatch Activities -->
                <Border Grid.Column="0" Background="{DynamicResource DialogSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="📱 ActivityWatch Activity (What you were doing)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Filtered &amp; bridged chronological foreground apps, web, and idle periods." FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <!-- Activity Toolbar: Idle Toggle & Selection Controls -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ShowIdleCheckBox" Content="Show Idle Periods" IsChecked="True"
                                      FontSize="11.5" Foreground="{DynamicResource PrimaryTextBrush}"
                                      VerticalAlignment="Center" Margin="0,0,6,0" Click="ShowIdleCheckBox_Click"/>
                            <TextBlock x:Name="SelectionSummaryText" Grid.Column="1" Text="0 selected"
                                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="6,0,6,0" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="SelectAllButton" Content="Select All" Height="24" Padding="8,0" FontSize="11"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Click="SelectAllButton_Click"/>
                                <Button x:Name="DeselectAllButton" Content="Clear" Height="24" Padding="8,0" FontSize="11"
                                        Style="{StaticResource SecondaryButton}" Click="DeselectAllButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Activity List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ActivitiesListContainer">
                                <!-- Populated dynamically in code -->
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Empty / Status Banner -->
                        <Border x:Name="ActivityWatchStatusCard" Grid.Row="2"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="16" Margin="12"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                            <StackPanel MaxWidth="360" HorizontalAlignment="Center">
                                <TextBlock x:Name="ActivityWatchStatusHeading" Text="⚠️ ActivityWatch is Offline" FontWeight="Bold" FontSize="13.5"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock x:Name="ActivityWatchStatusMessage"
                                           Text="Cannot connect to ActivityWatch at localhost:5600."
                                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14"/>
                                <StackPanel x:Name="ActivityWatchActionButtons" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="StartActivityWatchButton" Content="Start ActivityWatch" Height="30" Padding="14,0"
                                            Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="StartActivityWatchButton_Click"/>
                                    <Button x:Name="RetryActivityWatchButton" Content="Retry Connection" Height="30" Padding="14,0"
                                            Style="{StaticResource SecondaryButton}" Click="RetryActivityWatchButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Column Divider (empty gap) -->

                <!-- Right Column: Stopwatch Project Time Allocation -->
                <Border Grid.Column="2" Background="{DynamicResource DialogSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="⏱️ Stopwatch Time Allocation" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Assign selected activities on the left to stopwatch projects." FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <!-- Batch Labeling Box -->
                        <Border Grid.Row="1" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,2,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LabelSectionHeaderText" Text="🏷️ Label Selected Activities (0 selected)"
                                               FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"/>
                                    <CheckBox x:Name="AllowMultiLabelCheckBox" Grid.Column="1"
                                              Content="Allow multi-project overlap"
                                              ToolTip="When checked, a period can be labeled for multiple projects simultaneously. When unchecked, labeling a period again replaces its project with the latest label."
                                              FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                              VerticalAlignment="Center" Click="AllowMultiLabelCheckBox_Click"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="BatchProjectComboBox" Height="30" VerticalContentAlignment="Center"
                                              FontSize="11.5" FontFamily="{DynamicResource AppFontFamily}" Margin="0,0,6,0"/>
                                    <Button x:Name="BatchNewProjectButton" Grid.Column="1" Content="+ New" Height="30"
                                            Padding="10,0" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}"
                                            Click="BatchNewProjectButton_Click" ToolTip="Define a new project name"/>
                                    <Button x:Name="ApplyLabelButton" Grid.Column="2" Content="Label Selected" Height="30"
                                            Padding="12,0" Style="{StaticResource ActionButton}" Click="ApplyLabelButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Stopwatch Slots List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="StopwatchSlotsContainer">
                                <!-- Populated dynamically in code -->
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. Footer Bar -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Press Esc to skip without changes · Enter to complete report"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="11.5"
                           FontFamily="{DynamicResource AppFontFamily}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SkipReportButton" Content="Skip (Esc)" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="SkipReportButton_Click"/>
                    <Button x:Name="SaveReportButton" Content="Save &amp; Complete (Enter)" Style="{StaticResource ActionButton}" Click="SaveReportButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
