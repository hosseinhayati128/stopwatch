<Window x:Class="StopwatchOverlay.PeriodicReview.PeriodicReviewPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Periodic Review Prompt"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="PromptChoiceButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DialogSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PromptKeyBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="{DynamicResource ThemePanelBorderThickness}"
            CornerRadius="{DynamicResource ThemePanelCornerRadius}"
            Padding="20,16"
            Margin="10"
            MinWidth="380"
            MaxWidth="440">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="4" Opacity="0.55"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="✦ " Foreground="{DynamicResource AccentBrush}" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="Periodic Activity Review"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="15"
                           FontFamily="{DynamicResource AppFontFamily}"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Subtitle -->
            <TextBlock x:Name="PeriodSummaryText"
                       Text="Review what you were doing (14:00 – 14:30)"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontSize="13"
                       FontFamily="{DynamicResource AppFontFamily}"
                       FontWeight="Medium"
                       Margin="0,0,0,12"/>

            <!-- Option 1: Y Review Now -->
            <Button x:Name="ReviewNowButton" Style="{StaticResource PromptChoiceButtonStyle}" Click="ReviewNowButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PromptKeyBadgeStyle}">
                        <TextBlock Text="Y" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Check &amp; Complete Report Now" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Review ActivityWatch logs and assign stopwatch time" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Option 2: Esc Skip -->
            <Button x:Name="SkipButton" Style="{StaticResource PromptChoiceButtonStyle}" Click="SkipButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PromptKeyBadgeStyle}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="Esc" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Skip This Term" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="SkipSubText" Text="Remind again at next interval" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Footer: countdown and auto-close -->
            <Grid Margin="0,4,0,0">
                <TextBlock x:Name="FooterHintText"
                           Text="Press Y or Esc"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="11"
                           FontFamily="{DynamicResource AppFontFamily}"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="CountdownText"
                           Text="Closing in 5s (snoozes for 30m)"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="11"
                           FontFamily="{DynamicResource AppFontFamily}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
