<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:StopwatchOverlay.Themes">
 <FontFamily x:Key="NotesBodyFont">Georgia</FontFamily>
 <Style x:Key="NotesFrameStyle" TargetType="p:NoteArtworkBorder">
  <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="18"/><Setter Property="CornerRadius" Value="8"/>
  <Style.Triggers><Trigger Property="p:PirateVisual.Enabled" Value="True">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="24"/>
  </Trigger></Style.Triggers>
 </Style>
 <Style x:Key="NotesPaperStyle" TargetType="p:NoteArtworkBorder">
  <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/><Setter Property="Padding" Value="12"/><Setter Property="CornerRadius" Value="4"/>
  <Style.Triggers><Trigger Property="p:PirateVisual.Enabled" Value="True">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="22"/>
  </Trigger></Style.Triggers>
 </Style>
 <Style x:Key="NotesHeadingStyle" TargetType="TextBlock">
  <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="FontFamily" Value="{DynamicResource DisplayHeadingFontFamily}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
  <Style.Triggers><Trigger Property="p:PirateVisual.Enabled" Value="True">
   <Setter Property="FontSize" Value="24"/><Setter Property="FontFamily" Value="{DynamicResource PirateHeadingFont}"/><Setter Property="Foreground" Value="#F1D59A"/>
  </Trigger></Style.Triggers>
 </Style>
 <Style x:Key="NotesCompassButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
  <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="12,6"/>
  <Style.Triggers><Trigger Property="p:PirateVisual.Enabled" Value="True">
   <Setter Property="MinHeight" Value="62"/><Setter Property="FontSize" Value="24"/>
   <Setter Property="FontFamily" Value="{StaticResource NotesBodyFont}"/><Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Foreground" Value="#F4DCA5"/><Setter Property="Padding" Value="40,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <p:NoteArtworkBorder x:Name="Plank" Artwork="Button" Background="Transparent">
     <Viewbox Margin="{TemplateBinding Padding}" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Viewbox>
    </p:NoteArtworkBorder>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plank" Property="Opacity" Value=".85"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plank" Property="Opacity" Value=".66"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plank" Property="Effect"><Setter.Value><DropShadowEffect Color="#F7DD9A" BlurRadius="7" ShadowDepth="0"/></Setter.Value></Setter></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plank" Property="Opacity" Value=".45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Trigger></Style.Triggers>
 </Style>
</ResourceDictionary>
