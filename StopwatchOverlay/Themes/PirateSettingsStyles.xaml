<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:StopwatchOverlay.Themes">
 <Style x:Key="PiratePageHeader" TargetType="Border">
  <Setter Property="Height" Value="52"/><Setter Property="Background" Value="{DynamicResource ApplicationHeaderBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource SubtleDividerBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
  <Style.Triggers><Trigger Property="p:PirateVisual.Enabled" Value="True">
   <Setter Property="Height" Value="76"/><Setter Property="Background" Value="{DynamicResource PirateHeader}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource PirateBrass}"/><Setter Property="BorderThickness" Value="3"/>
   <Setter Property="CornerRadius" Value="5"/>
  </Trigger></Style.Triggers>
 </Style>
 <Style x:Key="PiratePageHeading" TargetType="TextBlock" BasedOn="{StaticResource AcanthusHeaderTitle}">
  <Style.Triggers><Trigger Property="p:PirateVisual.Enabled" Value="True">
   <Setter Property="FontFamily" Value="{DynamicResource PirateHeadingFont}"/><Setter Property="FontSize" Value="32"/>
   <Setter Property="Foreground" Value="#F2D8A4"/>
  </Trigger></Style.Triggers>
 </Style>
 <Style x:Key="PirateSettingsPreview" TargetType="Border" BasedOn="{StaticResource AcanthusPreviewWorkspace}">
  <Style.Triggers><Trigger Property="p:PirateVisual.Enabled" Value="True">
   <Setter Property="Background" Value="{DynamicResource PirateMap}"/><Setter Property="Padding" Value="16"/>
   <Setter Property="Margin" Value="16,18,10,8"/><Setter Property="BorderThickness" Value="3"/>
   <Setter Property="BorderBrush" Value="{DynamicResource PirateBrass}"/><Setter Property="CornerRadius" Value="5"/>
  </Trigger></Style.Triggers>
 </Style>
 <Style x:Key="PirateSettingsNavigation" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource NavigationRailBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SubtleDividerBrush}"/>
  <Setter Property="BorderThickness" Value="0,0,1,0"/><Setter Property="Padding" Value="10,20"/>
  <Style.Triggers><Trigger Property="p:PirateVisual.Enabled" Value="True">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="14,4,8,14"/>
  </Trigger></Style.Triggers>
 </Style>
 <Style x:Key="PirateNavigationItem" TargetType="ListBoxItem" BasedOn="{StaticResource AcanthusNavigationItem}">
  <Style.Triggers><Trigger Property="p:PirateVisual.Enabled" Value="True">
   <Setter Property="Foreground" Value="#54251A"/><Setter Property="FontFamily" Value="{DynamicResource PirateHeadingFont}"/>
   <Setter Property="FontSize" Value="22"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Paper" Background="{DynamicResource PiratePaperBrush}" BorderBrush="#957144" BorderThickness="2"
      CornerRadius="2" Margin="2,4" Padding="16,9">
     <Grid><Border Width="4" Background="{DynamicResource PirateBrass}" HorizontalAlignment="Left" Margin="-13,-8,0,-8"/>
      <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Paper" Property="BorderBrush" Value="#26998C"/><Setter Property="FontWeight" Value="Bold"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Paper" Property="Opacity" Value=".85"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Paper" Property="BorderBrush" Value="#26998C"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Trigger></Style.Triggers>
 </Style>
 <Style x:Key="PirateSettingsInspector" TargetType="ScrollViewer" BasedOn="{StaticResource AcanthusInspectorContent}">
  <Style.Triggers><Trigger Property="p:PirateVisual.Enabled" Value="True">
   <Setter Property="Background" Value="{DynamicResource PiratePaperBrush}"/><Setter Property="Margin" Value="8,18,18,18"/>
   <Setter Property="BorderBrush" Value="#B7925A"/><Setter Property="BorderThickness" Value="2"/>
  </Trigger></Style.Triggers>
 </Style>
 <Style x:Key="PirateSliderFill" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False"/><Setter Property="Background" Value="#16A48F"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
   <Grid Background="Transparent"><Border Background="{TemplateBinding Background}" Height="9" VerticalAlignment="Center" CornerRadius="4">
    <Border Background="#48EFCC" Height="2" Margin="2,1" VerticalAlignment="Top" Opacity=".6"/>
   </Border></Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PirateSettingsSlider" TargetType="Slider" BasedOn="{StaticResource AcanthusSettingsSlider}">
  <Style.Triggers><MultiTrigger><MultiTrigger.Conditions>
   <Condition Property="p:PirateVisual.Enabled" Value="True"/><Condition Property="Orientation" Value="Horizontal"/>
  </MultiTrigger.Conditions>
   <Setter Property="MinHeight" Value="32"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid x:Name="Surface" Background="Transparent" MinHeight="32">
     <Border Height="22" VerticalAlignment="Center" Background="{DynamicResource PirateBrassTexture}" BorderBrush="#79562F" BorderThickness="2" CornerRadius="10"/>
     <Border Height="11" Margin="9,0" VerticalAlignment="Center" Background="#4B3820" CornerRadius="5"/>
     <Track x:Name="PART_Track" Margin="9,0" Height="32" Orientation="Horizontal" VerticalAlignment="Center"
       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
       Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource PirateSliderFill}"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Width="25" Height="32"><Thumb.Template><ControlTemplate TargetType="Thumb">
       <Border Background="{DynamicResource PirateBrass}" BorderBrush="#74512B" BorderThickness="2" CornerRadius="6" Padding="4">
        <Border BorderBrush="#1C6757" BorderThickness="1" CornerRadius="3">
         <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#90FFE0"/><GradientStop Color="#13BA91" Offset=".4"/><GradientStop Color="#097663" Offset="1"/></LinearGradientBrush></Border.Background>
        </Border>
       </Border>
      </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource PirateSliderFill}" Background="Transparent" Opacity="0"/></Track.IncreaseRepeatButton>
     </Track>
     <Border x:Name="Focus" BorderBrush="#177D6C" BorderThickness="1" CornerRadius="5" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid><ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </MultiTrigger></Style.Triggers>
 </Style>
</ResourceDictionary>
