<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <DrawingBrush x:Key="AppBackgroundBrush" TileMode="Tile"
                  ViewportUnits="Absolute" Viewport="0,0,1,1"
                  ViewboxUnits="Absolute" Viewbox="0,0,1,1">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#031E30">
                <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#031E30"/>
    <SolidColorBrush x:Key="MenuForegroundBrush" Color="#C9D5D9"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#072A3D"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#10384B"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#214B60"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#14455B"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#476478"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#6E8390"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF1D8"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C9D5D9"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#E5B75C"/>
    <SolidColorBrush x:Key="TimerTextBrush" Color="#E5B75C"/>
    <SolidColorBrush x:Key="PrimaryActionBrush" Color="#BD3527"/>
    <SolidColorBrush x:Key="OnActionTextBrush" Color="#FFF7E8"/>
    <SolidColorBrush x:Key="DangerActionBrush" Color="#B83A3A"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FF735F"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#35C983"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F5BA53"/>
    <SolidColorBrush x:Key="MutedStatusBrush" Color="#808A93"/>
    <SolidColorBrush x:Key="RecBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="ThemeShadowBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="OverlayChromeBrush" Color="#CC000000"/>
    <SolidColorBrush x:Key="OverlayChromeBorderBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="OverlayHoverBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="OverlayPressedBrush" Color="#3AFFFFFF"/>
    <SolidColorBrush x:Key="OverlayActionForegroundBrush" Color="#FFF7E8"/>
    <SolidColorBrush x:Key="NeutralButtonHoverBackgroundBrush" Color="#10384B"/>
    <SolidColorBrush x:Key="NeutralButtonHoverBorderBrush" Color="#476478"/>
    <SolidColorBrush x:Key="NeutralButtonHoverForegroundBrush" Color="#FFF1D8"/>
    <SolidColorBrush x:Key="NeutralButtonPressedBackgroundBrush" Color="#10384B"/>
    <SolidColorBrush x:Key="NeutralButtonPressedBorderBrush" Color="#476478"/>
    <SolidColorBrush x:Key="NeutralButtonPressedForegroundBrush" Color="#FFF1D8"/>
    <sys:Double x:Key="NeutralButtonHoverOpacity">0.88</sys:Double>
    <sys:Double x:Key="NeutralButtonPressedOpacity">0.72</sys:Double>
    <SolidColorBrush x:Key="ApplicationHeaderBrush" Color="#031E30"/>
    <SolidColorBrush x:Key="NavigationRailBrush" Color="#072A3D"/>
    <SolidColorBrush x:Key="SelectedNavigationBrush" Color="#14455B"/>
    <SolidColorBrush x:Key="TableHeaderBrush" Color="#10384B"/>
    <SolidColorBrush x:Key="ChartSeries1Brush" Color="#E5B75C"/>
    <SolidColorBrush x:Key="ChartSeries2Brush" Color="#35C983"/>
    <SolidColorBrush x:Key="ChartSeries3Brush" Color="#F5BA53"/>
    <SolidColorBrush x:Key="ChartSeries4Brush" Color="#FF735F"/>
    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#072A3D"/>
    <SolidColorBrush x:Key="OverlayInnerRuleBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="OverlayToolbarSurfaceBrush" Color="#072A3D"/>
    <SolidColorBrush x:Key="OrnamentStrokeBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="OrnamentAccentBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ActiveItemBorderBrush" Color="#E5B75C"/>
    <SolidColorBrush x:Key="SubtleDividerBrush" Color="#476478"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#E5B75C"/>

    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayHeadingFontFamily">pack://application:,,,/StopwatchOverlay;component/Assets/Fonts/Acanthus/#Cormorant Garamond</FontFamily>
    <FontFamily x:Key="ThemeMonoFontFamily">Consolas</FontFamily>
    <FontFamily x:Key="ThemeTimerFontFamily">Consolas</FontFamily>
    <Visibility x:Key="OrnamentVisibility">Collapsed</Visibility>
    <Visibility x:Key="BrandIconVisibility">Visible</Visibility>

    <Thickness x:Key="ThemeControlBorderThickness">1</Thickness>
    <Thickness x:Key="ThemePanelBorderThickness">1</Thickness>
    <Thickness x:Key="ThemeButtonShadowMargin">0</Thickness>
    <Thickness x:Key="ThemeOverlayPadding">15,8</Thickness>
    <Thickness x:Key="ThemeOverlayFrameBorderThickness">0</Thickness>
    <Thickness x:Key="ThemeOverlayButtonBorderThickness">0</Thickness>
    <CornerRadius x:Key="ThemeControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ThemeItemCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ThemePopupCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="ThemePanelCornerRadius">9</CornerRadius>
    <CornerRadius x:Key="ThemeCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ThemeCheckCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="ThemeOverlayCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ThemeOverlayButtonCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="ThemeTimerPanelCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ThemeDashboardCardCornerRadius">10</CornerRadius>
    <DropShadowEffect x:Key="ThemePanelShadowEffect"
                      Color="#000000" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
</ResourceDictionary>
