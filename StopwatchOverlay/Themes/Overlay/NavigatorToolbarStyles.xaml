<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:StopwatchOverlay.Themes">
    <theme:NavigatorDialOpacityConverter x:Key="NavigatorDialOpacityConverter"/>
    <Style x:Key="NavigatorToolbarSurfaceStyle" TargetType="Border">
        <Setter Property="Padding" Value="{DynamicResource OverlayToolbarPadding}"/>
        <Setter Property="Background" Value="{DynamicResource OverlayToolbarSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OverlayToolbarBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource ThemePanelBorderThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayToolbarCornerRadius}"/>
        <Setter Property="Effect" Value="{DynamicResource OverlayToolbarShadowEffect}"/>
        <Style.Triggers>
            <Trigger Property="theme:NavigatorVisual.Enabled" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Effect" Value="{x:Null}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="NavigatorDialButtonTemplate" TargetType="Button">
        <Grid>
            <Grid.Opacity>
                <MultiBinding Converter="{StaticResource NavigatorDialOpacityConverter}">
                    <Binding Path="(theme:NavigatorVisual.OpaqueParts)" RelativeSource="{RelativeSource TemplatedParent}"/>
                    <Binding Path="(theme:NavigatorVisual.SurfaceOpacity)" RelativeSource="{RelativeSource TemplatedParent}"/>
                </MultiBinding>
            </Grid.Opacity>
        <Grid x:Name="ButtonArt" RenderTransformOrigin=".5,.5">
            <Image x:Name="DialImage" Stretch="Uniform" IsHitTestVisible="False"
                   Source="/StopwatchOverlay;component/Assets/Pirate/navigator-dial.png"/>
            <!-- A round hit surface follows the dial instead of swallowing its transparent corners. -->
            <Ellipse Margin="8" Fill="Transparent"/>
            <Ellipse x:Name="HoverRing" Margin="12" Stroke="#FFF2B3" StrokeThickness="2"
                     Opacity="0" IsHitTestVisible="False"/>
            <Viewbox Margin="0" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                     Height="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}"
                     IsHitTestVisible="False">
                <Canvas Width="100" Height="100">
                    <Path x:Name="ActionGlyph" Canvas.Left="29" Canvas.Top="29"
                          Width="42" Height="42" Stretch="Uniform"
                          Stroke="#352316" StrokeThickness="3" StrokeLineJoin="Round">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint=".6,1">
                                <GradientStop Color="#FFF0B2" Offset="0"/>
                                <GradientStop Color="#E5C776" Offset=".5"/>
                                <GradientStop Color="#A57C35" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                </Canvas>
            </Viewbox>
            <!-- Preserve the real content and its owner's named pause/resume nodes. -->
            <ContentPresenter Visibility="Collapsed"/>
        </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="theme:NavigatorVisual.Action" Value="Close">
                <Setter TargetName="ActionGlyph" Property="Data" Value="M 8,0 L 21,13 34,0 42,8 29,21 42,34 34,42 21,29 8,42 0,34 13,21 0,8 Z"/>
            </Trigger>
            <Trigger Property="theme:NavigatorVisual.Action" Value="Play">
                <Setter TargetName="ActionGlyph" Property="Data" Value="M 5,1 L 40,21 5,41 Z"/>
            </Trigger>
            <Trigger Property="theme:NavigatorVisual.Action" Value="Pause">
                <Setter TargetName="ActionGlyph" Property="Data" Value="M 3,2 H 15 V 40 H 3 Z M 27,2 H 39 V 40 H 27 Z"/>
            </Trigger>
            <Trigger Property="theme:NavigatorVisual.Action" Value="Reset">
                <Setter TargetName="ActionGlyph" Property="Data" Value="M 35,6 L 41,0 41,19 22,19 28,13 C 18,6 7,13 8,24 C 9,36 25,40 32,29 L 40,32 C 29,52 1,44 0,25 C -1,5 20,-5 35,6 Z"/>
            </Trigger>
            <Trigger Property="theme:NavigatorVisual.Action" Value="Edit">
                <Setter TargetName="ActionGlyph" Property="Data" Value="M 28,3 L 39,14 14,39 3,39 3,28 Z M 23,8 L 34,19"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HoverRing" Property="Opacity" Value=".7"/>
                <Setter TargetName="DialImage" Property="Opacity" Value=".9"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonArt" Property="RenderTransform">
                    <Setter.Value><ScaleTransform ScaleX=".96" ScaleY=".96"/></Setter.Value>
                </Setter>
                <Setter TargetName="HoverRing" Property="Opacity" Value=".9"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonArt" Property="Opacity" Value=".4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
