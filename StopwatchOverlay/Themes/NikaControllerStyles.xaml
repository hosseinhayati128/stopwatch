<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:StopwatchOverlay.Themes">
 <Style x:Key="NikaOnly" TargetType="FrameworkElement">
  <Setter Property="Visibility" Value="Collapsed"/>
  <Style.Triggers><Trigger Property="p:NikaVisual.Enabled" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger></Style.Triggers>
 </Style>
 <ControlTemplate x:Key="NikaButtonTemplate" TargetType="Button">
  <Border x:Name="Focus" CornerRadius="7" BorderBrush="#032337" BorderThickness="1" Padding="2">
   <Border x:Name="Surface" CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
     Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </Border>
  </Border>
  <ControlTemplate.Triggers>
   <Trigger Property="Tag" Value="NikaPrimary"><Setter TargetName="Focus" Property="BorderBrush" Value="Transparent"/><Setter TargetName="Focus" Property="Padding" Value="0"/></Trigger>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#215367"/><Setter TargetName="Surface" Property="BorderBrush" Value="#FFE1A0"/></Trigger>
   <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="Tag" Value="NikaPrimary"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="#DF4933"/></MultiTrigger>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".76"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="#D69B31"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>
 <ControlTemplate x:Key="NikaRailTemplate" TargetType="ListBoxItem">
  <Border x:Name="Card" BorderBrush="#375669" BorderThickness="1" Background="#A6002338" CornerRadius="5">
   <Grid><Border x:Name="Marker" Width="5" Background="Transparent" HorizontalAlignment="Left" CornerRadius="4,0,0,4"/>
    <ContentPresenter Margin="7,0,0,0"/>
   </Grid>
  </Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#F7BD50"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/><Setter TargetName="Card" Property="Background" Value="#0B3D56"/><Setter TargetName="Marker" Property="Background" Value="#F7BD50"/></Trigger>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#164B61"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#FFE5AC"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>
 <ControlTemplate x:Key="NikaModeTemplate" TargetType="RadioButton">
  <Border x:Name="Tab" TextElement.Foreground="{TemplateBinding Foreground}" Background="Transparent" CornerRadius="22" BorderBrush="Transparent" BorderThickness="1" Padding="10,4">
   <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
  </Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tab" Property="Background" Value="#00283E"/><Setter TargetName="Tab" Property="TextElement.Foreground" Value="#FFF0D6"/><Setter Property="FontFamily" Value="{DynamicResource NikaHeadingFont}"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="23"/></Trigger>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#5B401C"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#C58215"/><Setter TargetName="Tab" Property="BorderThickness" Value="3"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>
 <ControlTemplate x:Key="NikaMenuItemTemplate" TargetType="MenuItem">
  <Grid>
   <Border x:Name="MenuSurface" Background="Transparent" Padding="{TemplateBinding Padding}">
    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
   </Border>
   <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False">
    <Border Background="#062B40" BorderBrush="#C7A05A" BorderThickness="1" Padding="5"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></Border>
   </Popup>
  </Grid>
  <ControlTemplate.Triggers>
   <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="#225065"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>
 <Style x:Key="NikaTextAction" TargetType="Button">
  <Setter Property="Visibility" Value="Collapsed"/><Setter Property="Background" Value="Transparent"/>
  <Setter Property="Foreground" Value="#032337"/><Setter Property="BorderBrush" Value="#907443"/>
  <Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="8,4"/><Setter Property="Height" Value="40"/>
  <Setter Property="Template" Value="{DynamicResource NikaNavButtonTemplate}"/>
  <Style.Triggers><Trigger Property="p:NikaVisual.Enabled" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger></Style.Triggers>
 </Style>
 <ControlTemplate x:Key="NikaNavButtonTemplate" TargetType="Button">
  <Border x:Name="Surface" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True"/></Border>
  <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#334C7080"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#E5B75C"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers>
 </ControlTemplate>
 <ControlTemplate x:Key="NikaLapItemTemplate" TargetType="ListBoxItem">
  <Border x:Name="Row" CornerRadius="5" BorderBrush="#557D663D" BorderThickness="0,0,0,1" Background="Transparent" Height="43"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border>
  <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#407F531A"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#257F531A"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#8E622A"/></Trigger></ControlTemplate.Triggers>
 </ControlTemplate>
 <Style x:Key="NikaLegacyOnly" TargetType="FrameworkElement"><Style.Triggers><Trigger Property="p:NikaVisual.Enabled" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
 <p:NikaLapFieldConverter x:Key="NikaLapField"/>
 <Style x:Key="NikaChromeButton" TargetType="Button"><Setter Property="Template" Value="{StaticResource NikaNavButtonTemplate}"/></Style>
 <Style x:Key="NikaRailOverflow" TargetType="Button" BasedOn="{StaticResource NikaTextAction}"><Setter Property="Foreground" Value="#E7EDF0"/><Setter Property="FontSize" Value="24"/><Setter Property="Width" Value="30"/><Setter Property="Padding" Value="0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 <Style x:Key="NikaTitleRow" TargetType="Grid"><Setter Property="Margin" Value="0,6,0,12"/><Style.Triggers><Trigger Property="p:NikaVisual.Enabled" Value="True"><Setter Property="Height" Value="120"/><Setter Property="Margin" Value="0,0,0,13"/></Trigger></Style.Triggers></Style>
 <Style x:Key="NikaModeCapsule" TargetType="Border"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,0,14"/><Style.Triggers><Trigger Property="p:NikaVisual.Enabled" Value="True"><Setter Property="CornerRadius" Value="23"/><Setter Property="BorderBrush" Value="#A98F5C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="0,0,90,23"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="p:NikaVisual.Enabled" Value="True"/><Condition Property="p:NikaVisual.Compact" Value="True"/></MultiTrigger.Conditions><Setter Property="Margin" Value="0,0,0,23"/></MultiTrigger></Style.Triggers></Style>
 <Style x:Key="NikaLapHeading" TargetType="Grid" BasedOn="{StaticResource NikaOnly}"><Setter Property="Height" Value="36"/><Setter Property="TextElement.Foreground" Value="#032337"/><Setter Property="TextElement.FontSize" Value="12"/><Setter Property="TextElement.FontFamily" Value="Segoe UI"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 <Style x:Key="NikaLapValue" TargetType="TextBlock"><Setter Property="Foreground" Value="#032337"/><Setter Property="FontFamily" Value="{StaticResource PirateBodyFont}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="28"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 <Style x:Key="NikaKeycap" TargetType="Border"><Setter Property="BorderBrush" Value="#E1BB78"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="13,3"/><Setter Property="TextElement.Foreground" Value="#FFF2DE"/><Setter Property="TextElement.FontSize" Value="14"/></Style>
 <Style x:Key="NikaHeroContent" TargetType="StackPanel" BasedOn="{StaticResource NikaOnly}"><Setter Property="Margin" Value="0,0,90,0"/><Style.Triggers><Trigger Property="p:NikaVisual.Compact" Value="True"><Setter Property="Margin" Value="0"/></Trigger></Style.Triggers></Style>
 <Style x:Key="NikaFooterShortcuts" TargetType="StackPanel" BasedOn="{StaticResource NikaOnly}"><Style.Triggers><Trigger Property="p:NikaVisual.Compact" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
</ResourceDictionary>
