<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:StopwatchOverlay.Themes">
    <ControlTemplate x:Key="PirateSettingsSwitchTemplate" TargetType="CheckBox">
        <Grid x:Name="SwitchRoot" Background="Transparent" MinHeight="30">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Width="46" Height="28" VerticalAlignment="Center" Margin="0,0,10,0">
                <Border x:Name="FocusRing" Margin="-3" BorderBrush="{DynamicResource FocusBorderBrush}"
                        BorderThickness="1.5" CornerRadius="17" Visibility="Collapsed"/>
                <Border x:Name="Plate" Background="{DynamicResource PirateBrass}" BorderBrush="#5A3920"
                        BorderThickness="1" CornerRadius="14"/>
                <Border x:Name="Inset" Margin="3" Background="#68482E" BorderBrush="#785329"
                        BorderThickness="1" CornerRadius="11"/>
                <Path x:Name="Check" Data="M0,4 L3,7 L9,0" Stroke="#F6E6BF" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="10" Height="9" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="8,0,0,0" Visibility="Collapsed"/>
                <Border x:Name="Knob" Width="18" Height="18" HorizontalAlignment="Left" Margin="5,0"
                        VerticalAlignment="Center" CornerRadius="9" BorderThickness="1" BorderBrush="#6C4828"
                        Background="{DynamicResource PirateBrass}"/>
                <Path x:Name="MixedMark" Data="M0,0 H8" Stroke="#382519" StrokeThickness="2"
                      Width="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Inset" Property="Background" Value="#167C70"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="Inset" Property="Background" Value="#167C70"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Center"/>
                <Setter TargetName="MixedMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Plate" Property="BorderBrush" Value="#167C70"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Knob" Property="Opacity" Value="0.8"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="SwitchRoot" Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="PirateSettingsSwitch" TargetType="CheckBox" BasedOn="{StaticResource AcanthusSettingsSwitch}">
        <Style.Triggers>
            <Trigger Property="p:PirateVisual.Enabled" Value="True">
                <Setter Property="Template" Value="{StaticResource PirateSettingsSwitchTemplate}"/>
                <Setter Property="FontFamily" Value="{DynamicResource PirateBodyFont}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
